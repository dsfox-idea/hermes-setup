diff --git a/ui-tui/src/__tests__/activityStatus.test.ts b/ui-tui/src/__tests__/activityStatus.test.ts
new file mode 100644
index 0000000000..8b01c54210
--- /dev/null
+++ b/ui-tui/src/__tests__/activityStatus.test.ts
@@ -0,0 +1,93 @@
+import { stringWidth } from '@hermes/ink'
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import { $activitySignal, observeActivity } from '../app/activityStore.js'
+import { ActivityStatus } from '../lib/activityStatus.js'
+
+beforeEach(() => $activitySignal.set({ phase: 'waiting', sessionId: '', since: 0 }))
+
+describe('event-backed activity status', () => {
+  it.each([
+    [-1, 'statusGood'],
+    [0, 'statusGood'],
+    [10 * 60_000 - 1, 'statusGood'],
+    [10 * 60_000, 'statusWarn'],
+    [60 * 60_000 - 1, 'statusWarn'],
+    [60 * 60_000, 'statusCritical'],
+    [61 * 60_000, 'statusCritical']
+  ] as const)('selects the duration color at %s ms', (elapsed, expected) => {
+    expect(ActivityStatus.colorKey(elapsed)).toBe(expected)
+  })
+
+  it('keeps the phase clock stable across tokens and resets it at real transitions', () => {
+    observeActivity({ type: 'message.start' }, 'session', 1000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'One' } }, 'session', 2000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'Two' } }, 'session', 3000)
+    expect($activitySignal.get()).toEqual({ phase: 'reasoning', sessionId: 'session', since: 2000 })
+    observeActivity({ type: 'message.delta', payload: { text: 'Answer' } }, 'session', 4000)
+    expect($activitySignal.get().phase).toBe('answer')
+    expect($activitySignal.get().since).toBe(4000)
+    observeActivity({ type: 'tool.complete' }, 'session', 5000)
+    expect($activitySignal.get().phase).toBe('waiting')
+    observeActivity({ type: 'thinking.delta', payload: { text: 'synthesizing' } }, 'session', 6000)
+    expect($activitySignal.get().since).toBe(5000)
+  })
+
+  it('prioritizes user input, compaction and active tools without exposing command arguments', () => {
+    const tracker = new ActivityStatus()
+    const input = {
+      sessionId: 'session',
+      signal: { phase: 'answer' as const, sessionId: 'session', since: 1000 },
+      tools: [{ id: 'a', name: 'terminal', context: 'SECRET_ARGUMENT', startedAt: 1500 }],
+      compacting: false,
+      waiting: false
+    }
+    const tool = tracker.update(input, 2000)
+    expect(tool.label).toBe('Выполнение команды')
+    expect(tool.label).not.toContain('SECRET')
+    expect(tracker.update({ ...input, tools: [...input.tools, { id: 'b', name: 'read_file' }] }, 3000).label).toContain(
+      '+1'
+    )
+    expect(tracker.update(input, 4000).since).toBe(tool.since)
+    expect(tracker.update({ ...input, compacting: true }, 5000).label).toBe('Сжатие контекста')
+    const waiting = tracker.update({ ...input, compacting: true, waiting: true }, 6000)
+    expect(waiting.label).toBe('Требуется ответ')
+    expect(waiting.paused).toBe(true)
+  })
+
+  it('does not reuse another session state and resets time between requests', () => {
+    const tracker = new ActivityStatus()
+    const input = {
+      sessionId: 'new',
+      signal: { phase: 'answer' as const, sessionId: 'old', since: 1 },
+      tools: [],
+      compacting: false,
+      waiting: false
+    }
+    expect(tracker.update(input, 1000).label).toBe('Ожидание модели')
+    observeActivity({ type: 'message.start' }, 'new', 2000)
+    expect(tracker.update({ ...input, signal: $activitySignal.get() }, 2000).since).toBe(2000)
+    observeActivity({ type: 'message.start' }, 'new', 3000)
+    expect(tracker.update({ ...input, signal: $activitySignal.get() }, 3000).since).toBe(3000)
+  })
+
+  it('keeps pixel frames fixed-width, pauses for input and fits narrow status slots', () => {
+    const frames = Array.from({ length: 14 }, (_, tick) => ActivityStatus.frame(tick, false))
+    expect(new Set(frames).size).toBeGreaterThan(3)
+    expect(new Set(frames.map(stringWidth))).toEqual(new Set([10]))
+    expect(frames.every(frame => [...frame].filter(character => character === '█').length === 1)).toBe(true)
+    expect(frames[0]).toBe('[█░░░░░░░]')
+    expect(frames[7]).toBe('[░░░░░░░█]')
+    expect(ActivityStatus.frame(1, true)).toBe(ActivityStatus.frame(10, true))
+    for (const width of [8, 16, 28, 50]) {
+      const text = ActivityStatus.format(
+        { key: 'test', label: 'Получение рассуждений', paused: false, since: 0 },
+        4,
+        9000,
+        width
+      )
+      expect(stringWidth(text)).toBeLessThanOrEqual(width)
+      expect(text).not.toContain('\n')
+    }
+  })
+})
