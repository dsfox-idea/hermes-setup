+import { PassThrough } from 'node:stream'
+
+import { Box, renderSync } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+import { patchOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { patchTurnState, resetTurnState } from '../app/turnStore.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { StreamingAssistant } from '../components/streamingAssistant.js'
+import { EventTime } from '../lib/eventTime.js'
+import { fromSkin } from '../theme.js'
+
+const theme = fromSkin({ banner_dim: '#545E6B', status_bar_good: '#63D0A6' }, {})
+const cleanups: Array<() => void> = []
+const colorLevel = chalk.level
+
+class WorkingClockFixture {
+  output = ''
+  readonly view: ReturnType<typeof renderSync>
+
+  constructor(showProgressArea = true) {
+    const stdout = Object.assign(new PassThrough(), { columns: 80, isTTY: false, rows: 30 })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true, ref: () => {}, unref: () => {}, setRawMode: () => {}
+    })
+
+    stdout.on('data', chunk => { this.output += chunk.toString() })
+    this.view = renderSync(
+      <Box flexDirection="column">
+        <StreamingAssistant cols={80} compact detailsMode="expanded" detailsModeCommandOverride
+          progress={{ showProgressArea } as never} />
+      </Box>,
+      { stdout: stdout as never, stdin: stdin as never, stderr: stdout as never, patchConsole: false }
+    )
+    cleanups.push(() => { this.view.unmount(); this.view.cleanup() })
+  }
+
+  clear() { this.output = '' }
+
+  lines() {
+    return stripAnsi(this.output).split('\n').map(line => line.trimEnd()).filter(Boolean)
+  }
+
+  clocks() {
+    return new Parser().feed(this.output).filter(action => action.type === 'text')
+      .map(action => ({ text: action.graphemes.map(part => part.value).join(''), style: action.style }))
+      .filter(span => /^\d\d:\d\d:\d\d$/.test(span.text))
+  }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.setSystemTime(new Date(2026, 10, 9, 14, 7, 32, 0))
+  chalk.level = 2
+  resetUiState()
+  resetTurnState()
+  resetOverlayState()
+  patchUiState({ sid: 'clock-session', busy: true, theme })
+})
+afterEach(() => {
+  cleanups.splice(0).forEach(cleanup => cleanup())
+  resetOverlayState()
+  resetTurnState()
+  resetUiState()
+  chalk.level = colorLevel
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+describe('working transcript clock', () => {
+  it('ticks on one otherwise empty bright-green row before any output', async () => {
+    const fixture = new WorkingClockFixture(false)
+    expect(fixture.lines().at(-1)).toBe('14:07:32')
+    expect(fixture.clocks().at(-1)?.style.fg).toEqual({ type: 'indexed', index: 46 })
+    expect(fixture.clocks().at(-1)?.style.dim).toBe(false)
+    fixture.clear()
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(fixture.lines().at(-1)).toBe('14:07:33')
+  })
+
+  it('leaves arrived events gray and advances the single green row below them', async () => {
+    const fixture = new WorkingClockFixture()
+    await vi.advanceTimersByTimeAsync(1000)
+    fixture.clear()
+    patchTurnState({ streamSegments: [{ role: 'assistant', text: 'FIRST_EVENT', createdAt: EventTime.now() }] })
+    await vi.advanceTimersByTimeAsync(50)
+    expect(fixture.lines().slice(-2)[0]).toMatch(/^14:07:33\s+.*FIRST_EVENT$/)
+    expect(fixture.lines().at(-1)).toBe('14:07:33')
+    const clocks = fixture.clocks().slice(-2)
+    expect(clocks).toHaveLength(2)
+    expect(clocks[0]?.style.fg).not.toEqual({ type: 'indexed', index: 46 })
+    expect(clocks[1]?.style.fg).toEqual({ type: 'indexed', index: 46 })
+    fixture.clear()
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(fixture.lines().at(-1)).toBe('14:07:34')
+    expect(fixture.lines().slice(-2)[0]).toContain('14:07:33')
+  })
+
+  it('stops while waiting for an answer and resumes with current time', async () => {
+    const fixture = new WorkingClockFixture()
+    await vi.advanceTimersByTimeAsync(50)
+    fixture.clear()
+    patchOverlayState({ clarify: { requestId: 'question', questions: [{ qid: 'one', question: 'Question', choices: ['Yes'] }] } })
+    await vi.advanceTimersByTimeAsync(2000)
+    expect(fixture.clocks()).toEqual([])
+    fixture.clear()
+    resetOverlayState()
+    await vi.advanceTimersByTimeAsync(50)
+    expect(fixture.lines().at(-1)).toBe('14:07:34')
+  })
+
+  it('does not start a clock while idle', async () => {
+    patchUiState({ busy: false })
+    const fixture = new WorkingClockFixture()
+    await vi.advanceTimersByTimeAsync(2000)
+    expect(fixture.clocks()).toEqual([])
+  })
+
+  it('uses current time below a new event even before the next timer tick', async () => {
+    vi.setSystemTime(new Date(2026, 10, 9, 14, 7, 32, 800))
+    const fixture = new WorkingClockFixture()
+    await vi.advanceTimersByTimeAsync(250)
+    fixture.clear()
+    patchTurnState({ streamSegments: [{ role: 'assistant', text: 'NEW_EVENT', createdAt: EventTime.now() }] })
+    await vi.advanceTimersByTimeAsync(50)
+    expect(fixture.lines().slice(-2)[0]).toMatch(/^14:07:33\s+.*NEW_EVENT$/)
+    expect(fixture.lines().at(-1)).toBe('14:07:33')
+  })
+
+  it('keeps the clock below multiline streaming content without stamping continuation rows', async () => {
+    patchTurnState({ streamCreatedAt: EventTime.now(), streaming: 'FIRST_LINE\n\nCONTINUATION' })
+    const fixture = new WorkingClockFixture()
+    expect(fixture.lines().at(-1)).toBe('14:07:32')
+    expect(fixture.lines().find(line => line.includes('CONTINUATION'))).not.toMatch(/^\d\d:/)
+    expect(fixture.clocks().slice(-2).map(clock => clock.style.fg)).toEqual([
+      expect.not.objectContaining({ index: 46 }), { type: 'indexed', index: 46 }
+    ])
+  })
+
+  it('clears its ticking interval when work completes', async () => {
+    const interval = vi.spyOn(globalThis, 'setInterval')
+    const clear = vi.spyOn(globalThis, 'clearInterval')
+    const fixture = new WorkingClockFixture()
+    await vi.advanceTimersByTimeAsync(50)
+    const index = interval.mock.calls.findIndex(call => call[1] === 1000)
+    expect(index).toBeGreaterThanOrEqual(0)
+    const timer = interval.mock.results[index]?.value
+    fixture.clear()
+    patchUiState({ busy: false })
+    await vi.advanceTimersByTimeAsync(2000)
+    expect(clear).toHaveBeenCalledWith(timer)
+    expect(fixture.clocks()).toEqual([])
+  })
+})
