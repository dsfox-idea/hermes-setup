+    expect(contrastRatio('#ffffff', '#262626')).toBeGreaterThan(4.5)
+    expect(contrastRatio('#ffffff', '#005F00')).toBeGreaterThan(4.5)
+    expect(contrastRatio('#ffffff', '#008700')).toBeGreaterThan(4.5)
