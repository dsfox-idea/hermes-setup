@@ -0,0 +1,93 @@
+import { stringWidth } from '@hermes/ink'
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import { $activitySignal, observeActivity } from '../app/activityStore.js'
+import { ActivityStatus } from '../lib/activityStatus.js'
+
+beforeEach(() => $activitySignal.set({ phase: 'waiting', sessionId: '', since: 0 }))
+
+describe('event-backed activity status', () => {
+  it.each([
+    [-1, 'statusGood'],
+    [0, 'statusGood'],
+    [10 * 60_000 - 1, 'statusGood'],
+    [10 * 60_000, 'statusWarn'],
+    [60 * 60_000 - 1, 'statusWarn'],
+    [60 * 60_000, 'statusCritical'],
+    [61 * 60_000, 'statusCritical']
+  ] as const)('selects the duration color at %s ms', (elapsed, expected) => {
+    expect(ActivityStatus.colorKey(elapsed)).toBe(expected)
+  })
+
+  it('keeps the phase clock stable across tokens and resets it at real transitions', () => {
+    observeActivity({ type: 'message.start' }, 'session', 1000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'One' } }, 'session', 2000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'Two' } }, 'session', 3000)
+    expect($activitySignal.get()).toEqual({ phase: 'reasoning', sessionId: 'session', since: 2000 })
+    observeActivity({ type: 'message.delta', payload: { text: 'Answer' } }, 'session', 4000)
+    expect($activitySignal.get().phase).toBe('answer')
+    expect($activitySignal.get().since).toBe(4000)
+    observeActivity({ type: 'tool.complete' }, 'session', 5000)
+    expect($activitySignal.get().phase).toBe('waiting')
+    observeActivity({ type: 'thinking.delta', payload: { text: 'synthesizing' } }, 'session', 6000)
+    expect($activitySignal.get().since).toBe(5000)
+  })
+
+  it('prioritizes user input, compaction and active tools without exposing command arguments', () => {
+    const tracker = new ActivityStatus()
+    const input = {
+      sessionId: 'session',
+      signal: { phase: 'answer' as const, sessionId: 'session', since: 1000 },
+      tools: [{ id: 'a', name: 'terminal', context: 'SECRET_ARGUMENT', startedAt: 1500 }],
+      compacting: false,
+      waiting: false
+    }
+    const tool = tracker.update(input, 2000)
+    expect(tool.label).toBe('Выполнение команды')
+    expect(tool.label).not.toContain('SECRET')
+    expect(tracker.update({ ...input, tools: [...input.tools, { id: 'b', name: 'read_file' }] }, 3000).label).toContain(
+      '+1'
+    )
+    expect(tracker.update(input, 4000).since).toBe(tool.since)
+    expect(tracker.update({ ...input, compacting: true }, 5000).label).toBe('Сжатие контекста')
+    const waiting = tracker.update({ ...input, compacting: true, waiting: true }, 6000)
+    expect(waiting.label).toBe('Требуется ответ')
+    expect(waiting.paused).toBe(true)
+  })
+
+  it('does not reuse another session state and resets time between requests', () => {
+    const tracker = new ActivityStatus()
+    const input = {
+      sessionId: 'new',
+      signal: { phase: 'answer' as const, sessionId: 'old', since: 1 },
+      tools: [],
+      compacting: false,
+      waiting: false
+    }
+    expect(tracker.update(input, 1000).label).toBe('Ожидание модели')
+    observeActivity({ type: 'message.start' }, 'new', 2000)
+    expect(tracker.update({ ...input, signal: $activitySignal.get() }, 2000).since).toBe(2000)
+    observeActivity({ type: 'message.start' }, 'new', 3000)
+    expect(tracker.update({ ...input, signal: $activitySignal.get() }, 3000).since).toBe(3000)
+  })
+
+  it('keeps pixel frames fixed-width, pauses for input and fits narrow status slots', () => {
+    const frames = Array.from({ length: 14 }, (_, tick) => ActivityStatus.frame(tick, false))
+    expect(new Set(frames).size).toBeGreaterThan(3)
+    expect(new Set(frames.map(stringWidth))).toEqual(new Set([10]))
+    expect(frames.every(frame => [...frame].filter(character => character === '█').length === 1)).toBe(true)
+    expect(frames[0]).toBe('[█░░░░░░░]')
+    expect(frames[7]).toBe('[░░░░░░░█]')
+    expect(ActivityStatus.frame(1, true)).toBe(ActivityStatus.frame(10, true))
+    for (const width of [8, 16, 28, 50]) {
+      const text = ActivityStatus.format(
+        { key: 'test', label: 'Получение рассуждений', paused: false, since: 0 },
+        4,
+        9000,
+        width
+      )
+      expect(stringWidth(text)).toBeLessThanOrEqual(width)
+      expect(text).not.toContain('\n')
+    }
+  })
+})
diff --git a/ui-tui/src/__tests__/activityTicker.test.tsx b/ui-tui/src/__tests__/activityTicker.test.tsx
new file mode 100644
index 0000000000..b905c13e53
--- /dev/null
+++ b/ui-tui/src/__tests__/activityTicker.test.tsx
@@ -0,0 +1,175 @@
+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $activitySignal, observeActivity } from '../app/activityStore.js'
+import type { IndicatorStyle } from '../app/interfaces.js'
+import { patchOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { patchTurnState, resetTurnState } from '../app/turnStore.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { StatusRule } from '../components/appChrome.js'
+import { DEFAULT_THEME } from '../theme.js'
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+
+const cleanup: Array<() => void> = []
+const originalColorLevel = chalk.level
+
+beforeEach(() => {
+  chalk.level = 3
+  vi.useFakeTimers()
+  vi.setSystemTime(100_000)
+  resetUiState()
+  resetTurnState()
+  resetOverlayState()
+  patchUiState({ sid: 'test', busy: true })
+  $activitySignal.set({ phase: 'waiting', sessionId: 'test', since: 100_000 })
+})
+
+afterEach(() => {
+  chalk.level = originalColorLevel
+  cleanup.splice(0).forEach(dispose => dispose())
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+function mount(cols = 120, compacting = false) {
+  const stdout = Object.assign(new PassThrough(), { columns: cols, isTTY: false, rows: 20 })
+  const stdin = Object.assign(new PassThrough(), { isTTY: false })
+  const stderr = Object.assign(new PassThrough(), { isTTY: false })
+  let text = ''
+  stdout.on('data', chunk => {
+    text += chunk.toString()
+  })
+  const view = renderSync(
+    <StatusRule
+      bgCount={0}
+      busy
+      cols={cols}
+      compacting={compacting}
+      cwdLabel=""
+      liveSessionCount={0}
+      model="test-model"
+      status="running…"
+      statusColor={DEFAULT_THEME.color.muted}
+      t={DEFAULT_THEME}
+      indicatorStyle={'activity' as IndicatorStyle}
+      usage={{ context_max: 100000, context_used: 25000 }}
+    />,
+    {
+      patchConsole: false,
+      stdout: stdout as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stderr: stderr as unknown as NodeJS.WriteStream
+    }
+  )
+  cleanup.push(() => {
+    view.unmount()
+    view.cleanup()
+  })
+  return Object.assign(() => stripAnsi(text), {
+    raw: () => text,
+    clear: () => {
+      text = ''
+    }
+  })
+}
+
+describe('activity status rendering', () => {
+  it('changes the rendered color at the thresholds and resets it for a new phase', async () => {
+    const output = mount()
+    for (const [elapsed, colorKey] of [
+      [10 * 60_000 - 1, 'statusGood'],
+      [10 * 60_000, 'statusWarn'],
+      [60 * 60_000 - 1, 'statusWarn'],
+      [60 * 60_000, 'statusCritical']
+    ] as const) {
+      output.clear()
+      vi.setSystemTime(100_000 + elapsed - 250)
+      await vi.advanceTimersByTimeAsync(250)
+      const actual = new Parser()
+        .feed(output.raw())
+        .filter(
+          action =>
+            action.type === 'text' &&
+            action.graphemes
+              .map(part => part.value)
+              .join('')
+              .includes('Ожидание модели')
+        )
+        .at(-1)
+      const expected = new Parser()
+        .feed(chalk.hex(DEFAULT_THEME.color[colorKey])('reference'))
+        .find(action => action.type === 'text')
+      expect(actual?.type === 'text' && actual.style.fg).toEqual(expected?.type === 'text' && expected.style.fg)
+    }
+    output.clear()
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'New phase' } }, 'test')
+    await vi.advanceTimersByTimeAsync(250)
+    const actual = new Parser()
+      .feed(output.raw())
+      .filter(
+        action =>
+          action.type === 'text' &&
+          action.graphemes
+            .map(part => part.value)
+            .join('')
+            .includes('Получение рассуждений')
+      )
+      .at(-1)
+    const expected = new Parser()
+      .feed(chalk.hex(DEFAULT_THEME.color.statusGood)('reference'))
+      .find(action => action.type === 'text')
+    expect(actual?.type === 'text' && actual.style.fg).toEqual(expected?.type === 'text' && expected.style.fg)
+  })
+
+  it('renders a pixel bar and actual waiting phase instead of decorative verbs', () => {
+    const output = mount()
+    expect(output()).toContain('[█░░░░░░░]')
+    expect(output()).toContain('Ожидание модели')
+    expect(output()).toContain('0с')
+    expect(output()).toContain('test model')
+  })
+
+  it('renders active tools and prioritizes an open input prompt', () => {
+    patchTurnState({
+      tools: [
+        { id: 'read', name: 'read_file' },
+        { id: 'shell', name: 'terminal' }
+      ]
+    })
+    expect(mount()()).toContain('Чтение файла +1')
+    patchOverlayState({ sudo: { requestId: 'password' } })
+    const output = mount()
+    expect(output()).toContain('[────────]')
+    expect(output()).toContain('Требуется ответ')
+  })
+
+  it('shows compaction and avoids animation timers under a covering overlay', () => {
+    expect(mount(120, true)()).toContain('Сжатие контекста')
+    cleanup.splice(0).forEach(dispose => dispose())
+    patchOverlayState({ widget: { appId: 'cover', state: null } })
+    const timer = vi.spyOn(globalThis, 'setInterval')
+    mount()
+    expect(timer).not.toHaveBeenCalled()
+  })
+
+  it('updates the clock without resetting it on subsequent reasoning tokens', async () => {
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'First' } }, 'test')
+    const output = mount()
+    await vi.advanceTimersByTimeAsync(2000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'Next' } }, 'test')
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(output()).toContain('Получение рассуждений')
+    expect(output()).toContain('3с')
+  })
+
+  it('preserves model and context on a narrow terminal', () => {
+    const output = mount(60)
+    expect(output()).toContain('test model')
+    expect(output()).toContain('25k')
+  })
+})
