index 0000000000..21c73d1b94
--- /dev/null
+++ b/ui-tui/src/app/turnStats.ts
@@ -0,0 +1,151 @@
+import type { Usage } from '@hermes/shared/gateway-events'
+
+import { fmtDuration } from '../domain/messages.js'
+import { t } from '../i18n/runtime.js'
+
+import { $overlayState } from './overlayStore.js'
+
+export interface TurnStatsResult {
+  activeMs: number
+  costUsd?: null | number
+  modelTps: null | number
+  taskTps: null | number
+  totalMs: number
+  waitMs: number
+}
+
+/**
+ * Times one owned turn: from the Enter that submitted it to its final reply,
+ * minus the spans the user spent answering a prompt (clarify, approval, sudo,
+ * secret), plus the output tokens the turn produced.
+ */
+export class TurnStats {
+  private startedAt: null | number = null
+  private outputBefore = 0
+  private waitMs = 0
+  private promptSince: null | number = null
+
+  begin(now: number, usage: Usage): void {
+    this.startedAt = now
+    this.outputBefore = usage.output ?? 0
+    this.waitMs = 0
+    this.promptSince = null
+  }
+
+  observePrompt(open: boolean, now: number): void {
+    if (this.startedAt === null) {
+      return
+    }
+
+    if (open && this.promptSince === null) {
+      this.promptSince = now
+    } else if (!open && this.promptSince !== null) {
+      this.waitMs += now - this.promptSince
+      this.promptSince = null
+    }
+  }
+
+  cancel(): void {
+    this.startedAt = null
+    this.promptSince = null
+  }
+
+  finish(now: number, usage: Usage | undefined): null | TurnStatsResult {
+    if (this.startedAt === null) {
+      return null
+    }
+
+    this.observePrompt(false, now)
+    const totalMs = Math.max(0, now - this.startedAt)
+    const activeMs = Math.max(0, totalMs - this.waitMs)
+    const output = usage?.output
+    const tokens = typeof output === 'number' ? output - this.outputBefore : 0
+    const result: TurnStatsResult = {
+      activeMs,
+      modelTps: typeof usage?.avg_tps === 'number' && usage.avg_tps > 0 ? usage.avg_tps : null,
+      taskTps: tokens > 0 && activeMs > 0 ? tokens / (activeMs / 1000) : null,
+      totalMs,
+      waitMs: this.waitMs
+    }
+
+    this.cancel()
+
+    return result
+  }
+}
+
+export const turnStats = new TurnStats()
+
+$overlayState.listen(state => {
+  turnStats.observePrompt(Boolean(state.clarify || state.approval || state.sudo || state.secret), Date.now())
+})
+
+type Request = (method: string, params: Record<string, unknown>) => Promise<unknown>
+
+const RECEIPT_TIMEOUT_MS = 2000
+
+/**
+ * The cost of one turn: each committed turn result (`prompt.receipt include_result`) carries the
+ * agent's cumulative `estimated_cost_usd`, so a turn costs the difference to the previous result of
+ * the same session. Every completion, owned or not, moves the baseline.
+ */
+export class TurnCost {
+  private readonly cumulative = new Map<string, number>()
+
+  constructor(private readonly timeoutMs = RECEIPT_TIMEOUT_MS) {}
+
+  async settle(request: Request, sid: null | string | undefined, admissionId: unknown): Promise<null | number> {
+    if (!sid || typeof admissionId !== 'string' || !admissionId) {
+      return null
+    }
+
+    const total = await this.readTotal(request, sid, admissionId)
+
+    if (total === null) {
+      return null
+    }
+
+    const previous = this.cumulative.get(sid)
+    this.cumulative.set(sid, total)
+
+    if (previous === undefined) {
+      return null
+    }
+
+    // A rebuilt agent restarts its counter at zero: everything it holds is this turn's.
+    return total >= previous ? total - previous : total
+  }
+
+  private async readTotal(request: Request, sid: string, admissionId: string): Promise<null | number> {
+    const timeout = new Promise<null>(resolve => setTimeout(() => resolve(null), this.timeoutMs))
+    const receipt = request('prompt.receipt', { admission_id: admissionId, include_result: true, session_id: sid })
+      .then(raw => {
+        const cost = (raw as { result?: { estimated_cost_usd?: unknown } } | null)?.result?.estimated_cost_usd
+
+        return typeof cost === 'number' && Number.isFinite(cost) ? cost : null
+      })
+      .catch(() => null)
+
+    return Promise.race([receipt, timeout])
+  }
+}
+
+export const turnCost = new TurnCost()
+
+const usd = (value: number) => `≈$${value < 0.1 ? value.toFixed(3) : value.toFixed(2)}`
+
+const tps = (value: number) => (value >= 10 ? String(Math.round(value)) : value.toFixed(1))
+
+/** `⏱ 4m 12s (6m 40s with waiting) · 38 tok/s (model 72 tok/s) · ≈$0.09`; empty parts are left out. */
+export function formatTurnStats(stats: TurnStatsResult): string {
+  const time = stats.waitMs >= 1000
+    ? `${fmtDuration(stats.activeMs)} (${t('status.turnWithWait', fmtDuration(stats.totalMs))})`
+    : fmtDuration(stats.totalMs)
+  const speed = [
+    stats.taskTps === null ? '' : `${tps(stats.taskTps)} tok/s`,
+    stats.modelTps === null ? '' : `(${t('status.turnModelTps', tps(stats.modelTps))})`
+  ].filter(Boolean).join(' ')
+  const cost = typeof stats.costUsd === 'number' ? usd(stats.costUsd) : ''
+
+  return ['⏱ ' + time, speed, cost].filter(Boolean).join(' · ')
+}
