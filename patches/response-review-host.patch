+++ b/tests/gateway/test_response_review_events.py
@@ -0,0 +1,14 @@
+"""Independent reviewer output stays visible even when reasoning display is hidden."""
+
+from types import SimpleNamespace
+
+from gateway.local_viewer_events import publish_progress
+
+
+def test_review_result_is_a_separate_viewer_event():
+    events = []
+    turn = SimpleNamespace(_publish_execution=lambda kind, payload: events.append((kind, payload)))
+    publish_progress(turn, "review.result", "Heretic", "  Unverified observation.\n",
+                     {"model": "local-reviewer", "status": "completed"})
+    assert events == [("review.result", {"label": "Heretic", "text": "  Unverified observation.\n",
+                                          "model": "local-reviewer", "status": "completed"})]
