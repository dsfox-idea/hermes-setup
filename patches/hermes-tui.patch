+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createSelectionState } from '../../packages/hermes-ink/src/ink/selection.js'
+
+import { ClipboardFeedback } from '../app/clipboardFeedback.js'
+
+beforeEach(() => { vi.useFakeTimers() })
+afterEach(() => { vi.clearAllTimers(); vi.useRealTimers() })
+
+describe('copy-on-release feedback', () => {
+  it('copies only when dragging finishes, not on drag moves or later selection notifications', async () => {
+    const write = vi.fn(async () => true)
+    const feedback = new ClipboardFeedback(write)
+    let dragging = false
+    let notify!: () => void
+    const unsubscribe = vi.fn()
+    const selection = {
+      getState: () => ({ ...createSelectionState(), isDragging: dragging }),
+      getTextSelectionText: () => 'selected',
+      subscribe: (callback: () => void) => { notify = callback; return unsubscribe }
+    }
+    const stop = feedback.watchSelection(selection)
+    notify()
+    dragging = true
+    notify()
+    notify()
+    expect(write).not.toHaveBeenCalled()
+    dragging = false
+    notify()
+    await vi.waitFor(() => expect(write).toHaveBeenCalledExactlyOnceWith('selected'))
+    notify()
+    await Promise.resolve()
+    expect(write).toHaveBeenCalledTimes(1)
+    stop()
+    expect(unsubscribe).toHaveBeenCalledOnce()
+  })
+
+  it('waits for the clipboard write and displays success for two seconds', async () => {
+    let complete!: (result: boolean) => void
+    const write = vi.fn(() => new Promise<boolean>(resolve => { complete = resolve }))
+    const feedback = new ClipboardFeedback(write)
+    const pending = feedback.copyText('selected text')
+    await Promise.resolve()
+    expect(write).toHaveBeenCalledWith('selected text')
+    expect(feedback.visible.get()).toBe(false)
+    complete(true)
+    expect(await pending).toBe(true)
+    expect(feedback.visible.get()).toBe(true)
+    vi.advanceTimersByTime(1999)
+    expect(feedback.visible.get()).toBe(true)
+    vi.advanceTimersByTime(1)
+    expect(feedback.visible.get()).toBe(false)
+  })
+
+  it('does not overwrite the clipboard for an empty selection or announce failed writes', async () => {
+    const write = vi.fn(async () => false)
+    const feedback = new ClipboardFeedback(write)
+    expect(await feedback.copyText('')).toBe(false)
+    expect(write).not.toHaveBeenCalled()
+    expect(await feedback.copyText('selected')).toBe(false)
+    expect(feedback.visible.get()).toBe(false)
+  })
+
+  it('restarts the notice duration on another successful selection', async () => {
+    const feedback = new ClipboardFeedback(async () => true)
+    await feedback.copyText('first')
+    vi.advanceTimersByTime(1500)
+    await feedback.copyText('second')
+    vi.advanceTimersByTime(1500)
+    expect(feedback.visible.get()).toBe(true)
+    vi.advanceTimersByTime(500)
+    expect(feedback.visible.get()).toBe(false)
+  })
+
+  it('recovers after a rejected clipboard write without a false success notice', async () => {
+    const write = vi.fn().mockRejectedValueOnce(new Error('Clipboard unavailable')).mockResolvedValueOnce(true)
+    const feedback = new ClipboardFeedback(write)
+    expect(await feedback.copyText('failed')).toBe(false)
+    expect(feedback.visible.get()).toBe(false)
+    expect(await feedback.copyText('next')).toBe(true)
+    expect(feedback.visible.get()).toBe(true)
+  })
+
+  it('serializes writes so the latest selection is not overwritten by an older copy', async () => {
+    let finishFirst!: (result: boolean) => void
+    const write = vi.fn()
+      .mockImplementationOnce(() => new Promise<boolean>(resolve => { finishFirst = resolve }))
+      .mockResolvedValueOnce(true)
+    const feedback = new ClipboardFeedback(write)
+    const first = feedback.copyText('first')
+    const second = feedback.copyText('second')
+    await Promise.resolve()
+    expect(write).toHaveBeenCalledTimes(1)
+    finishFirst(true)
+    await Promise.all([first, second])
+    expect(write.mock.calls.map(call => call[0])).toEqual(['first', 'second'])
+  })
+})
