+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+import { StatusRule } from '../components/appChrome.js'
+import { messages } from '../i18n/runtime.js'
+import { fromSkin } from '../theme.js'
+
+const colorLevel = chalk.level
+
+beforeEach(() => {
+  chalk.level = 3
+})
+
+afterEach(() => {
+  chalk.level = colorLevel
+})
+
+class StatusFixture {
+  readonly theme = fromSkin({ background: '#1c1c1c', status_bar_good: '#63D0A6', banner_dim: '#545E6B' }, {})
+
+  render(overrides: Partial<React.ComponentProps<typeof StatusRule>> = {}) {
+    const stdout = Object.assign(new PassThrough(), { columns: 200, isTTY: false, rows: 24 })
+    const stdin = Object.assign(new PassThrough(), { isTTY: false })
+    const stderr = Object.assign(new PassThrough(), { isTTY: false })
+    let output = ''
+    stdout.on('data', chunk => {
+      output += chunk.toString()
+    })
+
+    const view = renderSync(
+      <StatusRule
+        bgCount={0}
+        busy
+        cols={200}
+        compacting
+        cwdLabel=""
+        liveSessionCount={0}
+        model="test-model"
+        status="running…"
+        statusColor={this.theme.color.muted}
+        t={this.theme}
+        usage={{ context_max: 100_000, context_used: 25_000, context_percent: 25, total: 25_000 }}
+        {...overrides}
+      />,
+      {
+        patchConsole: false,
+        stderr: stderr as unknown as NodeJS.WriteStream,
+        stdin: stdin as unknown as NodeJS.ReadStream,
+        stdout: stdout as unknown as NodeJS.WriteStream
+      }
+    )
+
+    view.unmount()
+    view.cleanup()
+
+    return new Parser()
+      .feed(output)
+      .filter(action => action.type === 'text')
+      .map(action => ({ text: action.graphemes.map(grapheme => grapheme.value).join(''), style: action.style }))
+  }
+}
+
+describe('busy status visibility', () => {
+  it.each([25, 75, 99])('uses the healthy context-bar green while busy at context percent %s', contextPercent => {
+    const fixture = new StatusFixture()
+    const reference = fixture.render().find(span => span.text.includes('25%'))
+
+    const working = fixture
+      .render({ usage: { context_max: 100_000, context_used: 25_000, context_percent: contextPercent } })
+      .find(span => span.text.includes(messages().status.compacting))
+
+    expect(reference).toBeDefined()
+    expect(working).toBeDefined()
+    expect(working?.style.fg).toEqual(reference?.style.fg)
+    expect(working?.style.dim).toBe(false)
+  })
+
+  it('uses the same green for ordinary animated activity messages', () => {
+    const fixture = new StatusFixture()
+    const reference = fixture.render().find(span => span.text.includes('25%'))
+    const working = fixture.render({ compacting: false }).find(span => span.text.includes('…'))
+
+    expect(working).toBeDefined()
+    expect(working?.style.fg).toEqual(reference?.style.fg)
+    expect(working?.style.dim).toBe(false)
+  })
+
+  it.each(['ready', 'interrupted', 'error: failed'])('preserves the supplied idle color for %s', status => {
+    const fixture = new StatusFixture()
+
+    const color =
+      status === 'ready'
+        ? fixture.theme.color.ok
+        : status === 'interrupted'
+          ? fixture.theme.color.warn
+          : fixture.theme.color.error
+
+    const expected = new Parser().feed(chalk.hex(color)('idle')).find(action => action.type === 'text')
+
+    const idle = fixture
+      .render({ busy: false, compacting: false, status, statusColor: color })
+      .find(span => span.text.includes(status))
+
+    expect(idle).toBeDefined()
+    expect(idle?.style.fg).toEqual(expected?.type === 'text' ? expected.style.fg : undefined)
+  })
+})
diff --git a/ui-tui/src/__tests__/clarifyAppearance.test.tsx b/ui-tui/src/__tests__/clarifyAppearance.test.tsx
