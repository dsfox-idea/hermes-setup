@@ -0,0 +1,121 @@
+import { PassThrough } from 'node:stream'
+
+import { Box, renderSync } from '@hermes/ink'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+import type { AppLayoutProps } from '../app/interfaces.js'
+import { resetOverlayState } from '../app/overlayStore.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { AppLayout } from '../components/appLayout.js'
+import { MessageLine } from '../components/messageLine.js'
+import { fromSkin } from '../theme.js'
+import type { Msg } from '../types.js'
+
+const colorLevel = chalk.level
+vi.mock('../app/gatewayContext.js', () => ({ useGateway: () => ({ gw: null }) }))
+beforeEach(() => { chalk.level = 2 })
+afterEach(() => { chalk.level = colorLevel; resetOverlayState(); resetUiState() })
+
+class BackgroundFixture {
+  readonly colors = { background: '#1c1c1c', user_message_bg: '#000000', input_bg: '#000000' }
+
+  render(element: React.ReactElement, columns = 40): string {
+    const stdout = Object.assign(new PassThrough(), { columns, isTTY: false, rows: 24 })
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true, isRaw: false, ref: vi.fn(), unref: vi.fn(), setRawMode: vi.fn()
+    })
+    const stderr = Object.assign(new PassThrough(), { isTTY: false })
+    let output = ''
+    stdout.on('data', chunk => { output += chunk.toString() })
+    const view = renderSync(element, {
+      patchConsole: false,
+      stdout: stdout as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stderr: stderr as unknown as NodeJS.WriteStream
+    })
+    view.unmount()
+    view.cleanup()
+    return output
+  }
+
+  message(message: Msg, colors = this.colors, columns = 40): string {
+    const theme = fromSkin(colors, {})
+    return this.render(
+      <Box backgroundColor={theme.background} flexDirection="column" width={columns}>
+        <MessageLine cols={columns} compact msg={message} t={theme} />
+      </Box>, columns
+    )
+  }
+
+  spans(output: string) {
+    return new Parser().feed(output).filter(action => action.type === 'text')
+  }
+
+  composer(input: string, inputBuf: string[] = [], columns = 40): string {
+    patchUiState({ theme: fromSkin(this.colors, {}), sid: 'background-fixture', statusBar: 'top' })
+    const props = {
+      actions: { setStickyPrompt: vi.fn() }, mouseTracking: 'off', progress: { showProgressArea: false },
+      composer: {
+        cols: columns, input, inputBuf, compIdx: 0, completions: [], empty: !input,
+        queuedDisplay: [], queueEditIdx: null, pagerPageSize: 10,
+        handleTextPaste: vi.fn(), submit: vi.fn(), updateInput: vi.fn(), voiceRecordKey: null
+      },
+      status: {
+        cwdLabel: '', goodVibesTick: 0, lastTurnEndedAt: null, sessionStartedAt: null,
+        sessionTitle: '', showStickyPrompt: false, statusColor: '#ffffff', stickyPrompt: '',
+        turnStartedAt: null, voiceLabel: ''
+      },
+      transcript: {
+        historyItems: [], scrollRef: { current: null }, virtualRows: [],
+        virtualHistory: { start: 0, end: 0, topSpacer: 0, bottomSpacer: 0, offsets: [] }
+      }
+    } as unknown as AppLayoutProps
+    return this.render(<AppLayout {...props} />, columns)
+  }
+}
+
+describe('skin-controlled user input backgrounds', () => {
+  it.each([40, 120])('paints the live composer and buffered lines black at width %s', columns => {
+    const fixture = new BackgroundFixture()
+    const output = fixture.composer('DRAFTVALUE', ['BUFFERED'], columns)
+    const spans = fixture.spans(output)
+    for (const label of ['DRAFTVALUE', 'BUFFERED']) {
+      const span = spans.find(value => value.graphemes.map(grapheme => grapheme.value).join('').includes(label))
+      expect(span?.style.bg, label).toEqual({ type: 'indexed', index: 16 })
+    }
+    expect(output).not.toContain('\x1b[48;2;')
+  })
+
+  it('keeps the empty composer black', () => {
+    const fixture = new BackgroundFixture()
+    const spans = fixture.spans(fixture.composer(''))
+    const prompt = spans.find(value => value.graphemes.some(grapheme => grapheme.value === '\u276f'))
+    expect(prompt?.style.bg).toEqual({ type: 'indexed', index: 16 })
+  })
+
+  it.each([40, 120])('paints user text and the row fill black in ANSI-256 at width %s', columns => {
+    const fixture = new BackgroundFixture()
+    const output = fixture.message({ role: 'user', text: 'USERFIRST\nUSERSECOND' }, fixture.colors, columns)
+    const spans = fixture.spans(output)
+    for (const label of ['USERFIRST', 'USERSECOND']) {
+      const span = spans.find(value => value.graphemes.map(grapheme => grapheme.value).join('').includes(label))
+      expect(span?.style.bg, label).toEqual({ type: 'indexed', index: 16 })
+    }
+    expect(spans.some(span => span.style.bg.type === 'indexed' && span.style.bg.index === 16 &&
+      span.graphemes.length > 10 && span.graphemes.every(grapheme => grapheme.value === ' '))).toBe(true)
+    expect(output).not.toContain('\x1b[48;2;')
+  })
+
+  it.each<Msg>([
+    { role: 'assistant', text: 'Assistant response' },
+    { role: 'system', text: 'System notice' },
+    { role: 'user', kind: 'notification', text: 'Service notice' }
+  ])('leaves other message kinds unchanged: $role/$kind', message => {
+    const fixture = new BackgroundFixture()
+    const original = { ...fixture.colors, user_message_bg: '', input_bg: '' }
+    expect(fixture.message(message)).toBe(fixture.message(message, original))
+  })
+})
