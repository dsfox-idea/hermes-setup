+import { atom } from 'nanostores'
+import type { useSelection } from '@hermes/ink'
+
+import { writeClipboardText } from '../lib/clipboard.js'
+
+export class ClipboardFeedback {
+  readonly visible = atom(false)
+  private pending: Promise<unknown> = Promise.resolve()
+  private timer: ReturnType<typeof setTimeout> | undefined
+
+  constructor(private readonly write: (text: string) => Promise<boolean> = writeClipboardText) {}
+
+  watchSelection(selection: Pick<ReturnType<typeof useSelection>, 'getState' | 'getTextSelectionText' | 'subscribe'>,
+    copy: () => void = () => { void this.copyText(selection.getTextSelectionText()) }): () => void {
+    const isDragging = () => Boolean((selection.getState() as { isDragging?: boolean } | null)?.isDragging)
+    let wasDragging = isDragging()
+    return selection.subscribe(() => {
+      const dragging = isDragging()
+      const released = wasDragging && !dragging
+      wasDragging = dragging
+      if (released) copy()
+    })
+  }
+
+  copyText(text: string): Promise<boolean> {
+    if (!text) return Promise.resolve(false)
+    const copy = this.pending.then(async () => {
+      const copied = await this.write(text).catch(() => false)
+      clearTimeout(this.timer)
+      this.visible.set(copied)
+      if (copied) {
+        this.timer = setTimeout(() => this.visible.set(false), 2000)
+        this.timer.unref?.()
+      }
+      return copied
+    })
+    this.pending = copy
+    return copy
+  }
+}
+
+export const clipboardFeedback = new ClipboardFeedback()
