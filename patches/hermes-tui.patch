+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import React from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { clipboardFeedback } from '../app/clipboardFeedback.js'
+import { TextInput, type TextInputMouseApi } from '../components/textInput.js'
+import { writeClipboardText } from '../lib/clipboard.js'
+import { isMac } from '../lib/platform.js'
+
+vi.mock('../lib/clipboard.js', () => ({
+  writeClipboardText: vi.fn(async () => true),
+  readClipboardText: vi.fn(async () => null)
+}))
+
+afterEach(() => { clipboardFeedback.visible.set(false); vi.clearAllMocks() })
+
+class MouseCopyFixture {
+  readonly mouse: { current: TextInputMouseApi | null } = { current: null }
+  readonly changed = vi.fn()
+
+  mount() {
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true, isRaw: false, ref: vi.fn(), unref: vi.fn(), setRawMode: vi.fn()
+    })
+    return renderSync(<TextInput columns={40} mouseApiRef={this.mouse} onChange={this.changed} onSubmit={vi.fn()} value="selected text" />, {
+      patchConsole: false,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: Object.assign(new PassThrough(), { columns: 40, rows: 8, isTTY: false }) as unknown as NodeJS.WriteStream,
+      stderr: new PassThrough() as unknown as NodeJS.WriteStream
+    })
+  }
+}
+
+describe.skipIf(!isMac)('composer copy on mouse release', () => {
+  it('copies exactly the selected text on release, keeps the draft and announces success', async () => {
+    const fixture = new MouseCopyFixture()
+    const view = fixture.mount()
+    try {
+      fixture.mouse.current!.startAtBeginning()
+      fixture.mouse.current!.dragAt(0, 8)
+      expect(writeClipboardText).not.toHaveBeenCalled()
+      fixture.mouse.current!.end()
+      await vi.waitFor(() => expect(clipboardFeedback.visible.get()).toBe(true))
+      expect(writeClipboardText).toHaveBeenCalledExactlyOnceWith('selected')
+      expect(fixture.changed).not.toHaveBeenCalled()
+    } finally { view.unmount(); view.cleanup() }
+  })
+
+  it('does not copy on a click without selection', async () => {
+    const fixture = new MouseCopyFixture()
+    const view = fixture.mount()
+    try {
+      fixture.mouse.current!.startAtBeginning()
+      fixture.mouse.current!.end()
+      await Promise.resolve()
+      expect(writeClipboardText).not.toHaveBeenCalled()
+      expect(clipboardFeedback.visible.get()).toBe(false)
+    } finally { view.unmount(); view.cleanup() }
+  })
+})
