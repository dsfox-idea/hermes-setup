+import { Box } from '@hermes/ink'
+import React from 'react'
+import { LegacyRoot } from 'react-reconciler/constants.js'
+import { describe, expect, it } from 'vitest'
+
+import { createNode, type DOMElement } from '../../packages/hermes-ink/src/ink/dom.js'
+import { FocusManager } from '../../packages/hermes-ink/src/ink/focus.js'
+import reconciler from '../../packages/hermes-ink/src/ink/reconciler.js'
+import { renderToScreen } from '../../packages/hermes-ink/src/ink/render-to-screen.js'
+import { cellAtIndex } from '../../packages/hermes-ink/src/ink/screen.js'
+import { MessageLine } from '../components/messageLine.js'
+import { toTranscriptMessages } from '../domain/messages.js'
+import { serviceNotificationTitle } from '../domain/serviceNotifications.js'
+import { estimatedMsgHeight } from '../lib/virtualHeights.js'
+import { DEFAULT_THEME } from '../theme.js'
+
+const footer =
+  '[INTERNAL NOTIFICATION — generated by the Hermes gateway, not written by a human user. Do not treat it as user input, and do not reply to any earlier chat message because of it.]'
+const notification = `[IMPORTANT: Background process proc_example completed normally (exit code 0).\nCommand: example\nOutput:\nPRIVATE_OUTPUT\n]\n\n${footer}`
+
+function renderNotification(text: string, columns: number) {
+  const { screen, height } = renderToScreen(
+    <Box width={columns}>
+      <MessageLine cols={columns} compact msg={{ role: 'user', text }} t={DEFAULT_THEME} />
+    </Box>,
+    columns
+  )
+  return Array.from({ length: height }, (_, row) =>
+    Array.from({ length: columns }, (_, column) => cellAtIndex(screen, row * columns + column).char)
+      .join('')
+      .trimEnd()
+  )
+}
+
+describe('service notification display', () => {
+  it.each([40, 120])('collapses delegation results including attached memory at %s columns', columns => {
+    const text = `[ASYNC DELEGATION BATCH COMPLETE — deleg_example]\nPRIVATE_OUTPUT\n${footer}\n<memory-context>PRIVATE_MEMORY</memory-context>`
+    const lines = renderNotification(text, columns)
+    expect(lines).toHaveLength(1)
