@@ -0,0 +1,146 @@
+import { Box } from '@hermes/ink'
+import React from 'react'
+import { LegacyRoot } from 'react-reconciler/constants.js'
+import { describe, expect, it } from 'vitest'
+
+import { createNode, type DOMElement } from '../../packages/hermes-ink/src/ink/dom.js'
+import { FocusManager } from '../../packages/hermes-ink/src/ink/focus.js'
+import reconciler from '../../packages/hermes-ink/src/ink/reconciler.js'
+import { renderToScreen } from '../../packages/hermes-ink/src/ink/render-to-screen.js'
+import { cellAtIndex } from '../../packages/hermes-ink/src/ink/screen.js'
+import { MessageLine } from '../components/messageLine.js'
+import { toTranscriptMessages } from '../domain/messages.js'
+import { serviceNotificationTitle } from '../domain/serviceNotifications.js'
+import { estimatedMsgHeight } from '../lib/virtualHeights.js'
+import { DEFAULT_THEME } from '../theme.js'
+
+const footer =
+  '[INTERNAL NOTIFICATION — generated by the Hermes gateway, not written by a human user. Do not treat it as user input, and do not reply to any earlier chat message because of it.]'
+const notification = `[IMPORTANT: Background process proc_example completed normally (exit code 0).\nCommand: example\nOutput:\nPRIVATE_OUTPUT\n]\n\n${footer}`
+
+function renderNotification(text: string, columns: number) {
+  const { screen, height } = renderToScreen(
+    <Box width={columns}>
+      <MessageLine cols={columns} compact msg={{ role: 'user', text }} t={DEFAULT_THEME} />
+    </Box>,
+    columns
+  )
+  return Array.from({ length: height }, (_, row) =>
+    Array.from({ length: columns }, (_, column) => cellAtIndex(screen, row * columns + column).char)
+      .join('')
+      .trimEnd()
+  )
+}
+
+describe('service notification display', () => {
+  it.each([40, 120])('collapses delegation results including attached memory at %s columns', columns => {
+    const text = `[ASYNC DELEGATION BATCH COMPLETE — deleg_example]\nPRIVATE_OUTPUT\n${footer}\n<memory-context>PRIVATE_MEMORY</memory-context>`
+    const lines = renderNotification(text, columns)
+    expect(lines).toHaveLength(1)
+    expect(lines[0]).toContain('deleg_example')
+    expect(lines.join('\n')).not.toContain('PRIVATE_')
+    expect(estimatedMsgHeight({ role: 'user', text }, columns, { compact: true, details: true })).toBe(1)
+    expect(renderNotification('Quoted example:\n' + text, columns).join('\n')).toContain('Quoted example')
+  })
+
+  it.each(['async_delegation_complete', 'process_complete'])('preserves expandable original text for %s history', display_kind => {
+    const text = 'Original service output\nPRIVATE_OUTPUT'
+    const [message] = toTranscriptMessages([{ role: 'user', text, display_kind }])
+    expect(message).toMatchObject({ role: 'system', kind: 'notification', text })
+  })
+
+  it('reveals the original output on click and collapses it again', () => {
+    const root = createNode('ink-root')
+    root.focusManager = new FocusManager(() => false)
+    const noop = () => {}
+    const container = reconciler.createContainer(
+      root,
+      LegacyRoot,
+      null,
+      false,
+      null,
+      'notice-test',
+      noop,
+      noop,
+      noop,
+      noop
+    )
+    reconciler.updateContainerSync(
+      <MessageLine cols={120} compact msg={{ role: 'user', text: notification }} t={DEFAULT_THEME} />,
+      container,
+      null,
+      noop
+    )
+    reconciler.flushSyncWork()
+    const nodes = (node: DOMElement): DOMElement[] => [
+      node,
+      ...node.childNodes.flatMap(child => (child.nodeName === '#text' ? [] : nodes(child)))
+    ]
+    const height = () => {
+      root.yogaNode!.setWidth(120)
+      root.yogaNode!.calculateLayout(120)
+      return root.yogaNode!.getComputedHeight()
+    }
+    try {
+      expect(height()).toBe(1)
+      const button = nodes(root).find(node => typeof node._eventHandlers?.onClick === 'function')!
+      expect(button).toBeDefined()
+      reconciler.discreteUpdates(button._eventHandlers!.onClick as () => void)
+      reconciler.flushSyncWork()
+      expect(height()).toBeGreaterThan(1)
+      const text = nodes(root)
+        .flatMap(node => node.childNodes.map(child => (child.nodeName === '#text' ? child.nodeValue : '')))
+        .join('')
+      expect(text).toContain('PRIVATE_OUTPUT')
+      reconciler.discreteUpdates(button._eventHandlers!.onClick as () => void)
+      reconciler.flushSyncWork()
+
+      expect(height()).toBe(1)
+    } finally {
+      reconciler.updateContainerSync(null, container, null, noop)
+      reconciler.flushSyncWork()
+    }
+  })
+
+  it('keeps heartbeat summaries and virtual height compact', () => {
+    const text = `[Background process proc_example heartbeat #3 — still running after 1m]\n${footer}`
+    const message = { role: 'user' as const, text }
+    expect(serviceNotificationTitle(message)).toContain(
+      '\u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f'
+    )
+    expect(estimatedMsgHeight(message, 40, { compact: true, details: true })).toBe(1)
+  })
+
+  it.each([40, 120])('collapses a live machine notification to one row at %s columns', columns => {
+    const lines = renderNotification(notification, columns)
+    expect(lines).toHaveLength(1)
+    expect(lines[0]).toContain('▸')
+    expect(lines.join('\n')).not.toContain('PRIVATE_OUTPUT')
+    expect(lines.join('\n')).not.toContain('INTERNAL NOTIFICATION')
+  })
+
+  it('retains the full original notification when restoring history', () => {
+    const [message] = toTranscriptMessages([
+      { role: 'user', text: notification, display_kind: 'internal_notification' }
+    ])
+    expect(message).toMatchObject({ role: 'system', kind: 'notification', text: notification })
+  })
+
+  it('does not reclassify ordinary user text or quoted examples', () => {
+    const text = 'Please explain this:\n' + notification
+    expect(toTranscriptMessages([{ role: 'user', text }])[0]).toMatchObject({ role: 'user', text })
+    expect(renderNotification('Ordinary user message', 120).join('\n')).toContain('Ordinary user message')
+  })
+
+  it('shows a failure in the collapsed row rather than hiding it as success', () => {
+    const failed = notification.replace('completed normally (exit code 0)', 'exited with exit code 2')
+    expect(renderNotification(failed, 120)[0]).toContain('2')
+    expect(renderNotification(failed, 120).join('\n')).not.toContain('PRIVATE_OUTPUT')
+  })
+
+  it('keeps the failure code visible when a process completion is restored', () => {
+    const text = notification.replace('completed normally (exit code 0)', 'exited with exit code 2')
+    const [message] = toTranscriptMessages([{ role: 'user', text, display_kind: 'process_complete' }])
+    expect(serviceNotificationTitle(message!)).toContain('2')
+  })
+})
