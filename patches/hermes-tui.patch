@@ -0,0 +1,38 @@
+import { atom } from 'nanostores'
+
+export type ActivityPhase = 'waiting' | 'reasoning' | 'answer' | 'preparing'
+
+export interface ActivitySignal {
+  phase: ActivityPhase
+  sessionId: string
+  since: number
+}
+
+interface ActivityEvent {
+  type: string
+  payload?: unknown
+}
+
+export const $activitySignal = atom<ActivitySignal>({ phase: 'waiting', sessionId: '', since: 0 })
+
+const PHASES: Record<string, ActivityPhase> = {
+  'message.start': 'waiting',
+  'message.complete': 'waiting',
+  'message.interim': 'waiting',
+  'tool.start': 'waiting',
+  'tool.complete': 'waiting',
+  'reasoning.delta': 'reasoning',
+  'message.delta': 'answer',
+  'tool.generating': 'preparing',
+  error: 'waiting'
+}
+
+export function observeActivity(event: ActivityEvent, sessionId: string, now = Date.now()) {
+  const phase = PHASES[event.type]
+  if (!phase) return
+  const payload = event.payload as Record<string, unknown> | undefined
+  if (event.type.endsWith('.delta') && !payload?.text) return
+  const previous = $activitySignal.get()
+  if (previous.phase === phase && previous.sessionId === sessionId && event.type !== 'message.start') return
+  $activitySignal.set({ phase, sessionId, since: now })
+}
