+import { Box } from '@hermes/ink'
+import React from 'react'
+import { describe, expect, it } from 'vitest'
+
+import { renderToScreen } from '../../packages/hermes-ink/src/ink/render-to-screen.js'
+import { cellAtIndex } from '../../packages/hermes-ink/src/ink/screen.js'
+import { MessageLine } from '../components/messageLine.js'
+import { buildToolTrailLine } from '../lib/text.js'
+import { DEFAULT_THEME } from '../theme.js'
+import type { DetailsMode, Msg } from '../types.js'
+
+class TranscriptFixture {
+  readonly messages: Msg[] = [
+    { role: 'assistant', text: 'Updating the background.' },
+    {
+      kind: 'trail',
+      role: 'system',
+      text: '',
+      tools: [
+        buildToolTrailLine('skill_view', 'hermes-agent'),
+        buildToolTrailLine('read_file', 'dsfox-skin.yaml'),
+        buildToolTrailLine('terminal', 'hermes config get display.skin')
+      ]
+    },
+    { role: 'assistant', text: 'Ready.', tools: [buildToolTrailLine('patch', '')] }
+  ]
+
+  render(compact: boolean, streaming = false, tools: DetailsMode = 'expanded'): string[] {
+    const columns = 120
+
+    const { screen, height } = renderToScreen(
+      <Box flexDirection="column">
+        {this.messages.map((msg, index) => (
+          <MessageLine
+            cols={120}
+            compact={compact}
+            isStreaming={streaming && index === this.messages.length - 1}
+            key={index}
+            msg={msg}
+            prev={this.messages[index - 1]}
+            sections={{ thinking: 'hidden', tools }}
+            t={DEFAULT_THEME}
+          />
+        ))}
+      </Box>,
+      columns
+    )
+
+    return Array.from({ length: height }, (_, row) =>
+      Array.from({ length: columns }, (_, column) => cellAtIndex(screen, row * columns + column).char)
+        .join('')
+        .trimEnd()
+    )
+  }
+}
+
+describe('compact transcript spacing', () => {
+  it('renders consecutive background event rows without blank lines', () => {
+    const fixture = new TranscriptFixture()
+    fixture.messages.splice(
+      0,
+      fixture.messages.length,
+      { role: 'system', kind: 'event', text: 'Background Process Failed (exit 1): test' },
+      { role: 'system', kind: 'event', text: 'Background Process Finished: test' }
+    )
+    const compact = fixture.render(true)
+    expect(compact).toHaveLength(2)
+    expect(compact.every(line => line.trim().length > 0)).toBe(true)
+    expect(fixture.render(false).filter(line => !line.trim())).toHaveLength(2)
+  })
+
+  it.each([false, true])('removes blank service rows around tool groups and responses (streaming=%s)', streaming => {
+    const lines = new TranscriptFixture().render(true, streaming)
+
+    expect(lines).not.toContain('')
+    expect(lines.join('\n')).toContain('Tool calls (3)')
+    expect(lines.join('\n')).toContain('Tool calls (1)')
+    expect(lines.join('\n')).toContain('Response')
+    expect(lines.join('\n')).toContain('Ready.')
+  })
+
+  it('retains all visible content while removing four service spacer rows', () => {
+    const fixture = new TranscriptFixture()
+    const spacious = fixture.render(false)
+    const compact = fixture.render(true)
+
+    expect(spacious.filter(line => !line.trim())).toHaveLength(4)
+    expect(compact).toEqual(spacious.filter(line => line.trim()))
+  })
+
+  it('does not leave spacer rows when tool sections are hidden', () => {
+    const lines = new TranscriptFixture().render(true, false, 'hidden')
+
+    expect(lines).toHaveLength(2)
+    expect(lines).not.toContain('')
+  })
+
+  it('keeps the existing separation around user messages', () => {
+    const fixture = new TranscriptFixture()
+    fixture.messages.unshift({ role: 'user', text: 'User prompt' })
+    const lines = fixture.render(true)
+    const promptRow = lines.findIndex(line => line.includes('User prompt'))
+
+    expect(promptRow).toBe(1)
+    expect(lines[promptRow + 1]).toBe('')
+  })
+
+  it('leaves code block layout unchanged', () => {
+    const fixture = new TranscriptFixture()
+    fixture.messages.splice(0, fixture.messages.length, { role: 'assistant', text: '```text\nfirst\n\nsecond\n```' })
+    expect(fixture.render(true)).toEqual(fixture.render(false))
+  })
+})
