+++ b/ui-tui/src/__tests__/clarifyChronology.test.tsx
@@ -0,0 +1,250 @@
+import { EventEmitter } from 'node:events'
+import { PassThrough } from 'node:stream'
+
+import { Box, renderSync } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { getOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { resetServerRequestsForTests } from '../app/serverRequestStore.js'
+import { turnController } from '../app/turnController.js'
+import { turnStats } from '../app/turnStats.js'
+import { getTurnState } from '../app/turnStore.js'
+import { getUiState, patchUiState, resetUiState } from '../app/uiStore.js'
+import { useMainApp } from '../app/useMainApp.js'
+import { MessageLine } from '../components/messageLine.js'
+import { StreamingAssistant } from '../components/streamingAssistant.js'
+import type { Msg } from '../types.js'
+
+class ChatHarness {
+  app!: ReturnType<typeof useMainApp>
+  gateway = Object.assign(new EventEmitter(), {
+    attached: true,
+    isCanonical: true,
+    drain: () => {},
+    getLogTail: () => '',
+    kill: () => {},
+    recordLog: () => {},
+    request: vi.fn((method: string): Promise<unknown> => {
+      if (method === 'clarify.respond') {return Promise.resolve({ status: 'accepted' })}
+
+      if (method === 'clarify.lock') {return Promise.resolve({ status: 'answered', remaining: [] })}
+
+      return new Promise(() => {})
+    })
+  })
+  instance: ReturnType<typeof renderSync>
+
+  constructor() {
+    const owner = this
+
+    function Harness() {
+      owner.app = useMainApp(owner.gateway as never)
+
+      return null
+    }
+
+    const stream = () => Object.assign(new PassThrough(), { columns: 100, isTTY: false, rows: 40 })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true, ref: () => {}, setRawMode: () => {}, unref: () => {}
+    })
+
+    this.instance = renderSync(<Harness />, {
+      patchConsole: false, stderr: stream() as never, stdin: stdin as never, stdout: stream() as never
+    })
+    patchUiState({ sid: 'chronology', storedSid: 'chronology', gatewayConnected: true })
+  }
+
+  emit(type: string, payload: Record<string, unknown> = {}) {
+    this.gateway.emit('event', { type, payload, session_id: 'chronology' })
+  }
+
+  tool(id: string) {
+    this.emit('tool.start', { name: 'terminal', tool_id: id, context: id })
+    this.emit('tool.complete', { name: 'terminal', tool_id: id, duration_s: 0.1 })
+  }
+
+  ask(shared: boolean, number = 1) {
+    const question = `QUESTION_${number}`
+
+    if (shared) {
+      this.emit('clarify.request', { prompt_id: `prompt-${number}`, execution_generation: 1, question, choices: ['Yes'] })
+    } else {
+      this.gateway.emit('request', {
+        id: `prompt-${number}`, method: 'clarify',
+        params: { session_id: 'chronology', questions: [{ qid: `prompt-${number}`, question, choices: ['Yes'] }] },
+        respond: vi.fn(), fail: vi.fn()
+      })
+    }
+  }
+
+  rows(): Msg[] {
+    return [...this.app.appTranscript.historyItems, ...getTurnState().streamSegments,
+      { role: 'assistant', text: getTurnState().streaming, tools: getTurnState().streamPendingTools }]
+  }
+
+  text() {
+    return this.rows().flatMap(message => [...(message.tools ?? []), message.text]).join('\n')
+  }
+
+  renderedText() {
+    const stdout = Object.assign(new PassThrough(), { columns: 100, isTTY: false, rows: 80 })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true, ref: () => {}, setRawMode: () => {}, unref: () => {}
+    })
+
+    let output = ''
+    stdout.on('data', chunk => { output += chunk.toString() })
+
+    const instance = renderSync(
+      <Box flexDirection="column">
+        {this.app.appTranscript.historyItems.map((message, index) =>
+          <MessageLine cols={100} detailsMode="expanded" detailsModeCommandOverride key={index}
+            msg={message} t={getUiState().theme} />)}
+        <StreamingAssistant cols={100} detailsMode="expanded" detailsModeCommandOverride
+          progress={this.app.appProgress} />
+      </Box>,
+      { patchConsole: false, stdout: stdout as never, stderr: stdout as never, stdin: stdin as never }
+    )
+
+    instance.unmount()
+    instance.cleanup()
+
+    return stripAnsi(output)
+  }
+
+  close() {
+    this.instance.unmount()
+    this.instance.cleanup()
+  }
+}
+
+let harness: ChatHarness
+beforeEach(() => {
+  vi.useFakeTimers()
+  resetUiState()
+  resetOverlayState()
+  resetServerRequestsForTests()
+  turnController.fullReset()
+  turnStats.cancel()
+  harness = new ChatHarness()
+})
+afterEach(() => {
+  harness.close()
+  turnController.fullReset()
+  turnStats.cancel()
+  resetOverlayState()
+  resetUiState()
+  vi.useRealTimers()
+})
+
+const settle = () => vi.advanceTimersByTimeAsync(50)
+
+const expectOrder = (text: string, markers: string[]) => {
+  let previous = -1
+
+  for (const marker of markers) {
+    const position = text.indexOf(marker)
+    expect(position, `${marker} must follow the previous event in ${text}`).toBeGreaterThan(previous)
+    previous = position
+  }
+}
+
+describe('clarify chronology through the mounted TUI', () => {
+  it('keeps the published timing summary after the final reply and accounts for question waiting', async () => {
+    await settle()
+    harness.emit('message.start')
+    turnStats.begin(Date.now(), { calls: 0, input: 0, output: 0, total: 0 })
+    harness.tool('BEFORE_MARKER')
+    harness.ask(true)
+    await vi.advanceTimersByTimeAsync(2000)
+    harness.app.appActions.answerClarifyQuestion('prompt-1', 'Yes')
+    await settle()
+    harness.tool('AFTER_MARKER')
+    harness.emit('message.complete', {
+      text: 'FINAL_MARKER', usage: { calls: 1, input: 0, output: 100, total: 100, avg_tps: 20 }
+    })
+    await settle()
+
+    expectOrder(harness.renderedText(), ['BEFORE_MARKER', 'QUESTION_1', 'AFTER_MARKER', 'FINAL_MARKER', '⏱'])
+    const summaries = harness.rows().filter(message => message.kind === 'stats')
+    expect(summaries).toHaveLength(1)
+    expect(summaries[0]?.text).toContain('with waiting')
+    expect(summaries[0]?.text).toContain('model 20 tok/s')
+  })
+
+  it('retains the answered question and its preceding actions if the turn later fails', async () => {
+    await settle()
+    harness.emit('message.start')
+    harness.tool('BEFORE_MARKER')
+    harness.ask(true)
+    await settle()
+    harness.app.appActions.answerClarifyQuestion('prompt-1', 'Yes')
+    await settle()
+    harness.emit('error', { message: 'FAILURE_MARKER' })
+    await settle()
+    expectOrder(harness.text(), ['BEFORE_MARKER', 'QUESTION_1', 'FAILURE_MARKER'])
+  })
+
+  it('keeps answered questions visible when tool and reasoning details are hidden', async () => {
+    await settle()
+    patchUiState({ detailsMode: 'hidden', detailsModeCommandOverride: true })
+    harness.emit('message.start')
+    harness.tool('BEFORE_MARKER')
+    harness.ask(true)
+    await settle()
+    harness.app.appActions.answerClarifyQuestion('prompt-1', 'Yes')
+    await settle()
+    expect(harness.app.appProgress.showProgressArea).toBe(true)
+    expect(harness.text()).toContain('QUESTION_1')
+  })
+
+  it.each([true, false])('keeps repeated questions between tools while live and after completion (shared=%s)', async shared => {
+    await settle()
+    harness.emit('message.start')
+    harness.emit('message.delta', { text: 'INTRO_MARKER' })
+    harness.tool('BEFORE_MARKER')
+
+    for (const number of [1, 2]) {
+      harness.ask(shared, number)
+      await settle()
+      expect(getOverlayState().clarify).not.toBeNull()
+      harness.app.appActions.answerClarifyQuestion(`prompt-${number}`, 'Yes')
+      await settle()
+      harness.tool(`AFTER_${number}`)
+    }
+
+    await settle()
+    const markers = ['INTRO_MARKER', 'BEFORE_MARKER', 'QUESTION_1', 'AFTER_1', 'QUESTION_2', 'AFTER_2']
+    expectOrder(harness.text(), markers)
+    expectOrder(harness.renderedText(), markers)
+    harness.emit('message.complete', { text: 'FINAL_MARKER' })
+    await settle()
+    expectOrder(harness.text(), [...markers, 'FINAL_MARKER'])
+    expectOrder(harness.renderedText(), [...markers, 'FINAL_MARKER'])
+    expect(harness.text().match(/QUESTION_1/g)).toHaveLength(1)
+    expect(harness.text().match(/QUESTION_2/g)).toHaveLength(1)
+  })
+
+  it.each(['cancel', 'timeout'])('preserves the position of an abandoned question (%s)', async outcome => {
+    await settle()
+    harness.emit('message.start')
+    harness.tool('BEFORE_MARKER')
+    harness.ask(false)
+    await settle()
+
+    if (outcome === 'cancel') {harness.app.appActions.cancelClarify()}
+    else {harness.emit('tool.complete', { name: 'clarify', tool_id: 'clarify-1' })}
+
+    await settle()
+    harness.tool('AFTER_MARKER')
+    await settle()
+    expectOrder(harness.text(), ['BEFORE_MARKER', 'QUESTION_1', 'AFTER_MARKER'])
+    harness.emit('message.complete', { text: 'FINAL_MARKER' })
+    await settle()
+    expectOrder(harness.text(), ['BEFORE_MARKER', 'QUESTION_1', 'AFTER_MARKER', 'FINAL_MARKER'])
+  })
+})
