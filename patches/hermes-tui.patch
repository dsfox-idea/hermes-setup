+    expect(theme.color.completionCurrentBg).toBe('#324867')
+    expect(fixture.renderElement(<ApprovalPrompt onChoice={vi.fn()} req={req} t={theme} />)).toBe(
+      fixture.renderElement(<ApprovalPrompt onChoice={vi.fn()} req={req} t={generic} />)
