+export class EventTime {
+  static readonly gutterWidth = 9
+  static readonly unknown = '--:--:--'
+  // Preserve a known-unknown time through nullish live-event defaults.
+  static readonly unavailable = 0
+
+  static now(): number {
+    return Date.now() / 1000
+  }
+
+  static format(createdAt: number | undefined): string | null {
+    if (typeof createdAt !== 'number' || !Number.isFinite(createdAt) || createdAt <= 0) {
+      return null
+    }
+
+    const date = new Date(Math.floor(createdAt) * 1000)
+
+    if (Number.isNaN(date.getTime())) {
+      return null
+    }
+
+    const hours = String(date.getHours()).padStart(2, '0')
+    const minutes = String(date.getMinutes()).padStart(2, '0')
+    const seconds = String(date.getSeconds()).padStart(2, '0')
+
+    return `${hours}:${minutes}:${seconds}`
+  }
+}
