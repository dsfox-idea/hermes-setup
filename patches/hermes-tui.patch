+  })
+
+  it.each(['async_delegation_complete', 'process_complete'])('preserves expandable original text for %s history', display_kind => {
+    const text = 'Original service output\nPRIVATE_OUTPUT'
+    const [message] = toTranscriptMessages([{ role: 'user', text, display_kind }])
+    expect(message).toMatchObject({ role: 'system', kind: 'notification', text })
+  })
+
+  it('reveals the original output on click and collapses it again', () => {
+    const root = createNode('ink-root')
+    root.focusManager = new FocusManager(() => false)
+    const noop = () => {}
+    const container = reconciler.createContainer(
+      root,
+      LegacyRoot,
+      null,
+      false,
+      null,
+      'notice-test',
+      noop,
+      noop,
+      noop,
+      noop
+    )
+    reconciler.updateContainerSync(
+      <MessageLine cols={120} compact msg={{ role: 'user', text: notification }} t={DEFAULT_THEME} />,
+      container,
+      null,
+      noop
+    )
+    reconciler.flushSyncWork()
+    const nodes = (node: DOMElement): DOMElement[] => [
+      node,
+      ...node.childNodes.flatMap(child => (child.nodeName === '#text' ? [] : nodes(child)))
+    ]
+    const height = () => {
+      root.yogaNode!.setWidth(120)
+      root.yogaNode!.calculateLayout(120)
+      return root.yogaNode!.getComputedHeight()
+    }
+    try {
+      expect(height()).toBe(1)
+      const button = nodes(root).find(node => typeof node._eventHandlers?.onClick === 'function')!
+      expect(button).toBeDefined()
+      reconciler.discreteUpdates(button._eventHandlers!.onClick as () => void)
+      reconciler.flushSyncWork()
+      expect(height()).toBeGreaterThan(1)
+      const text = nodes(root)
+        .flatMap(node => node.childNodes.map(child => (child.nodeName === '#text' ? child.nodeValue : '')))
+        .join('')
+      expect(text).toContain('PRIVATE_OUTPUT')
+      reconciler.discreteUpdates(button._eventHandlers!.onClick as () => void)
+      reconciler.flushSyncWork()
+
+      expect(height()).toBe(1)
+    } finally {
+      reconciler.updateContainerSync(null, container, null, noop)
+      reconciler.flushSyncWork()
+    }
+  })
+
+  it('keeps heartbeat summaries and virtual height compact', () => {
+    const text = `[Background process proc_example heartbeat #3 — still running after 1m]\n${footer}`
+    const message = { role: 'user' as const, text }
+    expect(serviceNotificationTitle(message)).toContain(
+      '\u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f'
+    )
+    expect(estimatedMsgHeight(message, 40, { compact: true, details: true })).toBe(1)
+  })
+
+  it.each([40, 120])('collapses a live machine notification to one row at %s columns', columns => {
+    const lines = renderNotification(notification, columns)
+    expect(lines).toHaveLength(1)
+    expect(lines[0]).toContain('▸')
+    expect(lines.join('\n')).not.toContain('PRIVATE_OUTPUT')
+    expect(lines.join('\n')).not.toContain('INTERNAL NOTIFICATION')
