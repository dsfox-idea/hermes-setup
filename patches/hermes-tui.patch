+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { createServerRequestHandler } from '../app/createServerRequestHandler.js'
+import { openCanonicalApproval, openCanonicalClarify } from '../app/gatewayCanonicalEvents.js'
+import { getOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { resetServerRequestsForTests } from '../app/serverRequestStore.js'
+import { EventTime } from '../lib/eventTime.js'
+
+type PromptKind = 'approval' | 'clarify'
+
+class PromptClockFixture {
+  constructor(private readonly channel: 'canonical' | 'legacy') {}
+
+  show(kind: PromptKind, replayed = false) {
+    if (this.channel === 'legacy') {
+      const handle = createServerRequestHandler({ ringPromptBell: vi.fn(), setStatus: vi.fn() })
+      handle({
+        id: 'clock-prompt', method: kind, replayed, respond: vi.fn(), fail: vi.fn(),
+        params: { session_id: 'clock-session', command: 'pwd', questions: [{ qid: 'one', question: 'Question' }] }
+      })
+
+      return
+    }
+
+    const event = {
+      session_id: 'clock-session', replayed,
+      payload: { prompt_id: 'clock-prompt', execution_generation: 1, command: 'pwd', question: 'Question' }
+    }
+
+    if (kind === 'approval') {
+      openCanonicalApproval({ ...event, type: 'approval.request' }, vi.fn(), vi.fn())
+    } else {
+      openCanonicalClarify({ ...event, type: 'clarify.request' }, vi.fn(), vi.fn())
+    }
+  }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.setSystemTime(new Date(2026, 10, 9, 14, 7, 32, 84))
+  resetOverlayState()
+  resetServerRequestsForTests()
+})
+afterEach(() => {
+  resetOverlayState()
+  resetServerRequestsForTests()
+  vi.useRealTimers()
+})
+
+describe.each(['canonical', 'legacy'] as const)('%s prompt timestamps', channel => {
+  it.each(['approval', 'clarify'] as const)('preserves the first observed time for repeated %s', kind => {
+    const fixture = new PromptClockFixture(channel)
+    fixture.show(kind)
+    const first = getOverlayState()[kind]?.createdAt
+    expect(first).toBe(Date.now() / 1000)
+    vi.advanceTimersByTime(5000)
+    fixture.show(kind)
+    expect(getOverlayState()[kind]?.createdAt).toBe(first)
+  })
+
+  it.each(['approval', 'clarify'] as const)('does not invent a time for replayed %s, including later redelivery', kind => {
+    const fixture = new PromptClockFixture(channel)
+    fixture.show(kind, true)
+    expect(getOverlayState()[kind]).not.toBeNull()
+    expect(EventTime.format(getOverlayState()[kind]?.createdAt)).toBeNull()
+    vi.advanceTimersByTime(5000)
+    fixture.show(kind)
+    expect(EventTime.format(getOverlayState()[kind]?.createdAt)).toBeNull()
+  })
+})
