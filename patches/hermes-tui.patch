+    <Box flexDirection="column">
+      <Text>plain</Text>
+      <Text backgroundColor="ansi256(22)">added</Text>
+    </Box>
+  )
+}))
+
+const colorLevel = chalk.level
+
+beforeEach(() => {
+  chalk.level = 2
+  patchOverlayState({ agents: true })
+})
+
+afterEach(() => {
+  chalk.level = colorLevel
+  resetOverlayState()
+  resetUiState()
+})
+
+const renderCanvas = (background?: string) => {
+  patchUiState({ theme: fromSkin(background ? { background } : {}, {}) })
+
+  return renderToScreen(<AppLayout {...({ mouseTracking: 'off' } as AppLayoutProps)} />, 20)
+}
+
+describe('AppLayout canvas background', () => {
+  it('paints blank viewport cells when the skin owns the background', () => {
+    const { screen, height } = renderCanvas('#121212')
+
+    expect(height).toBe(24)
+
+    for (const index of [0, 19, (height - 1) * 20, height * 20 - 1]) {
+      expect(cellAtIndex(screen, index).styleId & 1, `cell ${index} must have an opaque background`).toBe(1)
+    }
+  })
+
+  it.each([undefined, 'not-a-color'])(
+    'leaves the canvas transparent without a valid skin background: %s',
+    background => {
+      const { screen, height } = renderCanvas(background)
+
+      expect(cellAtIndex(screen, height * 20 - 1).styleId & 1).toBe(0)
+    }
+  )
+
+  it('preserves child highlights over the canvas background', () => {
+    const { screen } = renderCanvas('#121212')
+    const plain = cellAtIndex(screen, 0)
+    const highlighted = cellAtIndex(screen, 20)
+
+    expect(highlighted.styleId & 1).toBe(1)
+    expect(highlighted.styleId).not.toBe(plain.styleId)
+  })
+
+  it('emits explicit ANSI-256 backgrounds for both the canvas and child highlight', () => {
+    patchUiState({ theme: fromSkin({ background: '#121212' }, {}) })
+    const stdout = Object.assign(new PassThrough(), { columns: 20, isTTY: false, rows: 24 })
+    const stdin = Object.assign(new PassThrough(), { isTTY: false })
+    const stderr = Object.assign(new PassThrough(), { isTTY: false })
+    let output = ''
+    stdout.on('data', chunk => {
+      output += chunk.toString()
+    })
+
+    const view = renderSync(<AppLayout {...({ mouseTracking: 'off' } as AppLayoutProps)} />, {
+      patchConsole: false,
+      stderr: stderr as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: stdout as unknown as NodeJS.WriteStream
+    })
+
+    view.unmount()
+    view.cleanup()
+
+    expect(output).toContain('\x1b[48;5;233m')
+    expect(output).toContain('\x1b[48;5;22m')
+    expect(output).not.toContain('\x1b[48;2;')
+  })
+})
