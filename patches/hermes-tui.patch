+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $activitySignal, observeActivity } from '../app/activityStore.js'
+import type { IndicatorStyle } from '../app/interfaces.js'
+import { patchOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { patchTurnState, resetTurnState } from '../app/turnStore.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { StatusRule } from '../components/appChrome.js'
+import { DEFAULT_THEME } from '../theme.js'
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+
+const cleanup: Array<() => void> = []
+const originalColorLevel = chalk.level
+
+beforeEach(() => {
+  chalk.level = 3
+  vi.useFakeTimers()
+  vi.setSystemTime(100_000)
+  resetUiState()
+  resetTurnState()
+  resetOverlayState()
+  patchUiState({ sid: 'test', busy: true })
+  $activitySignal.set({ phase: 'waiting', sessionId: 'test', since: 100_000 })
+})
+
+afterEach(() => {
+  chalk.level = originalColorLevel
+  cleanup.splice(0).forEach(dispose => dispose())
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+function mount(cols = 120, compacting = false) {
+  const stdout = Object.assign(new PassThrough(), { columns: cols, isTTY: false, rows: 20 })
+  const stdin = Object.assign(new PassThrough(), { isTTY: false })
+  const stderr = Object.assign(new PassThrough(), { isTTY: false })
+  let text = ''
+  stdout.on('data', chunk => {
+    text += chunk.toString()
+  })
+  const view = renderSync(
+    <StatusRule
+      bgCount={0}
+      busy
+      cols={cols}
+      compacting={compacting}
+      cwdLabel=""
+      liveSessionCount={0}
+      model="test-model"
+      status="running…"
+      statusColor={DEFAULT_THEME.color.muted}
+      t={DEFAULT_THEME}
+      indicatorStyle={'activity' as IndicatorStyle}
+      usage={{ context_max: 100000, context_used: 25000 }}
+    />,
+    {
+      patchConsole: false,
+      stdout: stdout as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stderr: stderr as unknown as NodeJS.WriteStream
+    }
+  )
+  cleanup.push(() => {
+    view.unmount()
+    view.cleanup()
+  })
+  return Object.assign(() => stripAnsi(text), {
+    raw: () => text,
+    clear: () => {
+      text = ''
+    }
+  })
+}
+
+describe('activity status rendering', () => {
+  it('changes the rendered color at the thresholds and resets it for a new phase', async () => {
+    const output = mount()
+    for (const [elapsed, colorKey] of [
+      [10 * 60_000 - 1, 'statusGood'],
+      [10 * 60_000, 'statusWarn'],
+      [60 * 60_000 - 1, 'statusWarn'],
+      [60 * 60_000, 'statusCritical']
+    ] as const) {
+      output.clear()
+      vi.setSystemTime(100_000 + elapsed - 250)
+      await vi.advanceTimersByTimeAsync(250)
+      const actual = new Parser()
+        .feed(output.raw())
+        .filter(
+          action =>
+            action.type === 'text' &&
+            action.graphemes
+              .map(part => part.value)
+              .join('')
+              .includes('Ожидание модели')
+        )
+        .at(-1)
+      const expected = new Parser()
+        .feed(chalk.hex(DEFAULT_THEME.color[colorKey])('reference'))
+        .find(action => action.type === 'text')
+      expect(actual?.type === 'text' && actual.style.fg).toEqual(expected?.type === 'text' && expected.style.fg)
+    }
+    output.clear()
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'New phase' } }, 'test')
+    await vi.advanceTimersByTimeAsync(250)
+    const actual = new Parser()
+      .feed(output.raw())
+      .filter(
+        action =>
+          action.type === 'text' &&
+          action.graphemes
+            .map(part => part.value)
+            .join('')
+            .includes('Получение рассуждений')
+      )
+      .at(-1)
+    const expected = new Parser()
+      .feed(chalk.hex(DEFAULT_THEME.color.statusGood)('reference'))
+      .find(action => action.type === 'text')
+    expect(actual?.type === 'text' && actual.style.fg).toEqual(expected?.type === 'text' && expected.style.fg)
+  })
+
+  it('renders a pixel bar and actual waiting phase instead of decorative verbs', () => {
+    const output = mount()
+    expect(output()).toContain('[█░░░░░░░]')
+    expect(output()).toContain('Ожидание модели')
+    expect(output()).toContain('0с')
+    expect(output()).toContain('test model')
+  })
+
+  it('renders active tools and prioritizes an open input prompt', () => {
+    patchTurnState({
+      tools: [
+        { id: 'read', name: 'read_file' },
+        { id: 'shell', name: 'terminal' }
+      ]
+    })
+    expect(mount()()).toContain('Чтение файла +1')
+    patchOverlayState({ sudo: { requestId: 'password' } })
+    const output = mount()
+    expect(output()).toContain('[────────]')
+    expect(output()).toContain('Требуется ответ')
+  })
+
+  it('shows compaction and avoids animation timers under a covering overlay', () => {
+    expect(mount(120, true)()).toContain('Сжатие контекста')
+    cleanup.splice(0).forEach(dispose => dispose())
+    patchOverlayState({ widget: { appId: 'cover', state: null } })
+    const timer = vi.spyOn(globalThis, 'setInterval')
+    mount()
+    expect(timer).not.toHaveBeenCalled()
+  })
+
+  it('updates the clock without resetting it on subsequent reasoning tokens', async () => {
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'First' } }, 'test')
+    const output = mount()
+    await vi.advanceTimersByTimeAsync(2000)
+    observeActivity({ type: 'reasoning.delta', payload: { text: 'Next' } }, 'test')
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(output()).toContain('Получение рассуждений')
+    expect(output()).toContain('3с')
+  })
+
+  it('preserves model and context on a narrow terminal', () => {
+    const output = mount(60)
+    expect(output()).toContain('test model')
+    expect(output()).toContain('25k')
+  })
+})
