diff --git a/ui-tui/src/__tests__/eventTimestampLifecycle.test.ts b/ui-tui/src/__tests__/eventTimestampLifecycle.test.ts
new file mode 100644
index 0000000000..8eacef624d
--- /dev/null
+++ b/ui-tui/src/__tests__/eventTimestampLifecycle.test.ts
@@ -0,0 +1,108 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { turnController } from '../app/turnController.js'
+import { getTurnState } from '../app/turnStore.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { toTranscriptMessages } from '../domain/messages.js'
+import { EventTime } from '../lib/eventTime.js'
+
+const instant = new Date(2026, 10, 9, 14, 7, 32, 84)
+const createdAt = instant.getTime() / 1000
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.setSystemTime(instant)
+  resetUiState()
+  turnController.fullReset()
+  patchUiState({ showReasoning: true })
+  turnController.startMessage()
+})
+afterEach(() => {
+  turnController.fullReset()
+  resetUiState()
+  vi.useRealTimers()
+})
+
+describe('event timestamp lifecycle', () => {
+  it('keeps an unknown restored stream time through further deltas and completion', () => {
+    turnController.hydrateStreamingText('Restored')
+    expect(EventTime.format(getTurnState().streamCreatedAt)).toBeNull()
+    vi.advanceTimersByTime(5000)
+    turnController.recordMessageDelta({ text: ' continuation' })
+    const result = turnController.recordMessageComplete({ text: 'Restored continuation' })
+    const message = result.finalMessages.find(row => row.text === 'Restored continuation')
+    expect(message).toBeDefined()
+    expect(EventTime.format(message?.createdAt)).toBeNull()
+  })
+
+  it('keeps an unknown restored stream time when sealing a segment', () => {
+    turnController.hydrateStreamingText('Restored')
+    vi.advanceTimersByTime(5000)
+    turnController.flushStreamingSegment()
+    const message = getTurnState().streamSegments.find(row => row.text === 'Restored')
+    expect(message).toBeDefined()
+    expect(EventTime.format(message?.createdAt)).toBeNull()
+  })
+
+  it('retains an observed stream time when hydrating after an idle snapshot', () => {
+    turnController.recordMessageDelta({ text: 'Observed' })
+    turnController.idle({ keepTurnArchive: true })
+    vi.advanceTimersByTime(5000)
+    turnController.hydrateStreamingText('Observed continuation')
+    expect(getTurnState().streamCreatedAt).toBe(createdAt)
+  })
+
+  it('preserves the text time when an idle snapshot arrives before completion', () => {
+    turnController.recordMessageDelta({ text: 'Final text' })
+    vi.advanceTimersByTime(100)
+    turnController.idle({ keepTurnArchive: true })
+    vi.advanceTimersByTime(5000)
+    const result = turnController.recordMessageComplete({ text: 'Final text' })
+    expect(result.finalMessages.find(message => message.text === 'Final text')?.createdAt).toBe(createdAt)
+  })
+
+  it('preserves distinct start times for identical completed tool calls after grouping', () => {
+    turnController.recordToolStart('first', 'terminal', 'same command')
+    vi.advanceTimersByTime(5000)
+    turnController.recordToolComplete('first', 'terminal', '', 5)
+    vi.advanceTimersByTime(5000)
+    turnController.recordToolStart('second', 'terminal', 'same command')
+    vi.advanceTimersByTime(5000)
+    turnController.recordToolComplete('second', 'terminal', '', 5)
+    const completed = turnController.recordMessageComplete({ text: 'Done' })
+    const times = completed.finalMessages.flatMap(message => message.toolCreatedAt ?? [])
+    expect(times).toEqual([createdAt, createdAt + 10])
+  })
+
+  it('keeps the first text event time through streaming and completion', () => {
+    turnController.recordMessageDelta({ text: 'Hello' })
+    vi.advanceTimersByTime(100)
+    const firstTime = getTurnState().streamCreatedAt
+    vi.advanceTimersByTime(5000)
+    turnController.recordMessageDelta({ text: ' world' })
+    vi.advanceTimersByTime(100)
+    expect(getTurnState().streamCreatedAt).toBe(firstTime)
+    expect(firstTime).toBe(createdAt)
+    const result = turnController.recordMessageComplete({ text: 'Hello world' })
+    expect(result.finalMessages.find(message => message.text === 'Hello world')?.createdAt).toBe(createdAt)
+  })
+
+  it('keeps the first reasoning event time through updates', () => {
+    turnController.recordReasoningDelta('First thought')
+    expect(getTurnState().streamSegments[0]?.createdAt).toBe(createdAt)
+    vi.advanceTimersByTime(5000)
+    turnController.recordReasoningDelta(' then more')
+    expect(getTurnState().streamSegments[0]?.createdAt).toBe(createdAt)
+  })
+
+  it('retains saved tool and display-event times without using the replay clock', () => {
+    const result = toTranscriptMessages([
+      { role: 'tool', name: 'terminal', context: 'first', timestamp: createdAt },
+      { role: 'tool', name: 'terminal', context: 'second', timestamp: createdAt + 1 },
+      { role: 'system', text: 'switch', display_kind: 'model_switch', timestamp: createdAt + 2 }
+    ])
+
+    expect(result[0]?.toolCreatedAt).toEqual([createdAt, createdAt + 1])
+    expect(result[1]?.createdAt).toBe(createdAt + 2)
+  })
+})
diff --git a/ui-tui/src/__tests__/eventTimestamps.test.tsx b/ui-tui/src/__tests__/eventTimestamps.test.tsx
new file mode 100644
index 0000000000..723d557a7e
--- /dev/null
+++ b/ui-tui/src/__tests__/eventTimestamps.test.tsx
@@ -0,0 +1,151 @@
+import { PassThrough } from 'node:stream'
+
+import { renderSync, stringWidth } from '@hermes/ink'
+import { stripAnsi } from '@hermes/shared/ansi'
+import React from 'react'
+import { describe, expect, it } from 'vitest'
+
+import { MessageLine } from '../components/messageLine.js'
+import { ClarifyPrompt } from '../components/prompts.js'
+import { EventTime } from '../lib/eventTime.js'
+import { buildToolTrailLine } from '../lib/text.js'
+import { DEFAULT_THEME } from '../theme.js'
+import type { Msg } from '../types.js'
+
+class EventScreen {
+  static renderElement(element: React.ReactElement, columns = 80) {
+    const stdout = Object.assign(new PassThrough(), { columns, rows: 80, isTTY: false })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true,
+      ref: () => {},
+      unref: () => {},
+      setRawMode: () => {}
+    })
+
+    let output = ''
+    stdout.on('data', chunk => {
+      output += chunk.toString()
+    })
+
+    const instance = renderSync(element, {
+      stdout: stdout as never,
+      stdin: stdin as never,
+      stderr: stdout as never,
+      patchConsole: false
+    })
+
+    const frame = output
+    instance.unmount()
+    instance.cleanup()
+
+    return stripAnsi(frame)
+      .split('\n')
+      .filter(line => line.trim())
+  }
+
+  static render(message: Msg, columns = 80) {
+    return EventScreen.renderElement(
+      <MessageLine
+        cols={columns}
+        compact
+        detailsMode="expanded"
+        detailsModeCommandOverride
+        msg={message}
+        t={DEFAULT_THEME}
+      />,
+      columns
+    )
+  }
+}
+
+const date = new Date(2026, 10, 9, 14, 7, 32, 84)
+const createdAt = date.getTime() / 1000
+
+describe('absolute event timestamps', () => {
+  it.each([24, 32, 80])('keeps the timestamp and wrapped content within %s columns', columns => {
+    for (const role of ['user', 'assistant'] as const) {
+      const lines = EventScreen.render(
+        { role, createdAt, text: 'First long line of text.\nSecond long line of text.' },
+        columns
+      )
+
+      expect(
+        lines.every(line => stringWidth(line) <= columns),
+        lines.join('\n')
+      ).toBe(true)
+      expect(lines.join('\n').match(/14:07:32/g)).toHaveLength(1)
+    }
+  })
+
+  it('does not borrow a later reply time for a tool with an unknown saved time', () => {
+    const lines = EventScreen.render({
+      role: 'assistant',
+      text: 'Reply',
+      createdAt,
+      tools: [buildToolTrailLine('terminal', 'OLD_TOOL')],
+      toolCreatedAt: [undefined]
+    })
+
+    expect(lines.find(line => line.includes('OLD_TOOL'))).toMatch(/^--:--:--\s/)
+  })
+
+  it('stamps the active question without adding stamps to its answer choices', () => {
+    const req = {
+      requestId: 'question',
+      createdAt,
+      questions: [{ qid: 'one', question: 'QUESTION_MARKER', choices: ['CHOICE_MARKER'] }]
+    }
+
+    const lines = EventScreen.renderElement(
+      <ClarifyPrompt onCancel={() => {}} onQuestionAnswer={() => {}} req={req} t={DEFAULT_THEME} />
+    )
+
+    expect(lines.find(line => line.includes('QUESTION_MARKER'))).toMatch(/^14:07:32\s/)
+    expect(lines.find(line => line.includes('CHOICE_MARKER'))).not.toContain('14:07:32')
+  })
+
+  it('formats local time to seconds without rounding into the next second', () => {
+    expect(EventTime.format(createdAt)).toBe('14:07:32')
+    expect(EventTime.format(Math.floor(createdAt) + 0.9999)).toBe('14:07:32')
+  })
+
+  it.each<Msg>([
+    { role: 'user', text: 'EVENT_MARKER' },
+    { role: 'assistant', text: 'EVENT_MARKER' },
+    { role: 'system', text: 'EVENT_MARKER' },
+    { role: 'system', kind: 'event', text: 'EVENT_MARKER' },
+    { role: 'system', kind: 'notification', notificationTitle: 'EVENT_MARKER', text: 'Details' }
+  ])('stamps a $role $kind event on its first content line without an opt-in', message => {
+    const lines = EventScreen.render({ ...message, createdAt })
+    const line = lines.find(value => value.includes('EVENT_MARKER'))
+    expect(line).toMatch(/^14:07:32\s+.*EVENT_MARKER/)
+  })
+
+  it('does not repeat the timestamp on continuation lines', () => {
+    const lines = EventScreen.render({ role: 'user', text: 'FIRST_LINE\nSECOND_LINE', createdAt })
+    expect(lines.find(line => line.includes('FIRST_LINE'))).toMatch(/^14:07:32\s/)
+    expect(lines.find(line => line.includes('SECOND_LINE'))).toMatch(/^\s+SECOND_LINE/)
+    expect(lines.join('\n').match(/14:07:32/g)).toHaveLength(1)
+  })
+
+  it('keeps separate times for repeated tools in a merged group', () => {
+    const message = {
+      role: 'system',
+      kind: 'trail',
+      text: '',
+      createdAt,
+      tools: [buildToolTrailLine('terminal', 'FIRST_TOOL'), buildToolTrailLine('terminal', 'SECOND_TOOL')],
+      toolCreatedAt: [createdAt, createdAt + 1.125]
+    } as Msg
+
+    const lines = EventScreen.render(message)
+    expect(lines.find(line => line.includes('FIRST_TOOL'))).toMatch(/^14:07:32\s/)
+    expect(lines.find(line => line.includes('SECOND_TOOL'))).toMatch(/^14:07:33\s/)
+  })
+
+  it('marks an unknown historical time instead of inventing the current time', () => {
+    const lines = EventScreen.render({ role: 'system', text: 'OLD_EVENT' })
+    expect(lines.find(line => line.includes('OLD_EVENT'))).toMatch(/^--:--:--\s/)
+  })
+})
