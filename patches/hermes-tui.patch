+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import { contrastRatio } from '@hermes/shared/color'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+import { ApprovalPrompt, ClarifyPrompt } from '../components/prompts.js'
+import { fromSkin, type Theme } from '../theme.js'
+import type { ClarifyReq } from '../types.js'
+
+const colorLevel = chalk.level
+
+beforeEach(() => {
+  chalk.level = 2
+})
+
+afterEach(() => {
+  chalk.level = colorLevel
+})
+
+class ChoicePromptFixture {
+  readonly colors = {
+    background: '#1c1c1c',
+    ui_accent: '#87AF87',
+    completion_menu_bg: '#151C2F',
+    completion_menu_current_bg: '#324867',
+    clarify_bg: '#262626',
+    clarify_text: '#ffffff',
+    clarify_selected_bg: '#005F00'
+  }
+
+  readonly request: ClarifyReq = {
+    requestId: 'choice-style-fixture',
+    questions: [{ qid: 'appearance', question: 'Choose an option', choices: ['First option', 'Second option'] }]
+  }
+
+  render(theme = fromSkin(this.colors, {}), request = this.request): string {
+    return this.renderElement(
+      <ClarifyPrompt cols={80} onCancel={vi.fn()} onQuestionAnswer={vi.fn()} req={request} t={theme} />
+    )
+  }
+
+  renderElement(element: React.ReactElement): string {
+    const stdout = Object.assign(new PassThrough(), { columns: 80, isTTY: false, rows: 24 })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true,
+      isRaw: false,
+      ref: vi.fn(),
+      unref: vi.fn(),
+      setRawMode: vi.fn()
+    })
+
+    const stderr = Object.assign(new PassThrough(), { isTTY: false })
+    let output = ''
+    stdout.on('data', chunk => {
+      output += chunk.toString()
+    })
+
+    const view = renderSync(element, {
+      patchConsole: false,
+      stderr: stderr as unknown as NodeJS.WriteStream,
+      stdin: stdin as unknown as NodeJS.ReadStream,
+      stdout: stdout as unknown as NodeJS.WriteStream
+    })
+
+    view.unmount()
+    view.cleanup()
+
+    return output
+  }
+}
+
+describe('ClarifyPrompt palette', () => {
+  it('paints the card gray with white text and a green selected row in ANSI-256', () => {
+    const output = new ChoicePromptFixture().render()
+
+    expect(output).toContain('\x1b[48;5;235m')
+    expect(output).toContain('\x1b[38;5;231m')
+    expect(output).toContain('\x1b[48;5;28m')
+    expect(contrastRatio('#ffffff', '#262626')).toBeGreaterThan(4.5)
+    expect(contrastRatio('#ffffff', '#005F00')).toBeGreaterThan(4.5)
+    expect(contrastRatio('#ffffff', '#008700')).toBeGreaterThan(4.5)
+  })
+
+  it('keeps questions, unselected choices, and hints white without dimming', () => {
+    const output = new ChoicePromptFixture().render()
+    const spans = new Parser().feed(output).filter(action => action.type === 'text')
+
+    for (const label of ['Choose an option', 'Second option', 'answered']) {
+      const span = spans.find(action =>
+        action.graphemes
+          .map(grapheme => grapheme.value)
+          .join('')
+          .includes(label)
+      )
+
+      expect(span?.style.fg, label).toEqual({ type: 'indexed', index: 231 })
+      expect(span?.style.dim, label).toBe(false)
+    }
+  })
+
+  it('does not change the shared palette or approval prompts', () => {
+    const fixture = new ChoicePromptFixture()
+    const theme = fromSkin(fixture.colors, {})
+    const original = JSON.stringify(theme)
+    const generic: Theme = { ...theme, clarify: undefined }
+    const req = { requestId: 'approval-fixture', command: 'printf hello', description: 'Test command' }
+
+    fixture.render(theme)
+    expect(JSON.stringify(theme)).toBe(original)
+    expect(theme.background).toBe('#1c1c1c')
+    expect(theme.color.completionCurrentBg).toBe('#324867')
+    expect(fixture.renderElement(<ApprovalPrompt onChoice={vi.fn()} req={req} t={theme} />)).toBe(
+      fixture.renderElement(<ApprovalPrompt onChoice={vi.fn()} req={req} t={generic} />)
+    )
+  })
+
+  it('preserves the original appearance when scoped colors are absent', () => {
+    const fixture = new ChoicePromptFixture()
+    const theme = fromSkin({ background: '#1c1c1c' }, {})
+
+    expect(fixture.render(theme)).not.toContain('\x1b[48;5;235m')
+  })
+
+  it.each([true, false])('keeps multi-select and free-text questions readable (multi-select=%s)', multiSelect => {
+    const fixture = new ChoicePromptFixture()
+
+    const req: ClarifyReq = {
+      requestId: 'alternate-question-fixture',
+      questions: [
+        { qid: 'q1', question: 'Choose an option', choices: multiSelect ? ['First', 'Second'] : null, multiSelect }
+      ]
+    }
+
+    const output = fixture.render(fromSkin(fixture.colors, {}), req)
+
+    expect(output).toContain('\x1b[48;5;235m')
+    expect(output).toContain('\x1b[38;5;231m')
+  })
+})
