+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+
+import { Parser } from '../../packages/hermes-ink/src/ink/termio.js'
+import { StatusRule } from '../components/appChrome.js'
+import { MessageLine } from '../components/messageLine.js'
+import { ClarifyPrompt } from '../components/prompts.js'
+import { fromSkin } from '../theme.js'
+
+const colorLevel = chalk.level
+beforeEach(() => {
+  chalk.level = 2
+})
+afterEach(() => {
+  chalk.level = colorLevel
+})
+
+class TimestampColorFixture {
+  readonly theme = fromSkin(
+    {
+      background: '#1c1c1c',
+      banner_dim: '#545E6B',
+      status_bar_text: '#C9D1D9',
+      clarify_bg: '#262626',
+      clarify_text: '#ffffff',
+      clarify_selected_bg: '#005F00'
+    },
+    {}
+  )
+  readonly createdAt = new Date(2026, 10, 9, 14, 7, 32, 84).getTime() / 1000
+
+  render(element: React.ReactElement) {
+    const stdout = Object.assign(new PassThrough(), { columns: 100, isTTY: false, rows: 30 })
+
+    const stdin = Object.assign(new PassThrough(), {
+      isTTY: true,
+      ref: () => {},
+      unref: () => {},
+      setRawMode: () => {}
+    })
+
+    let output = ''
+    stdout.on('data', chunk => {
+      output += chunk.toString()
+    })
+
+    const view = renderSync(element, {
