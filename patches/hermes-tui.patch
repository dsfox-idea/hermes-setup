+import { Text } from '@hermes/ink'
+import { useStore } from '@nanostores/react'
+import { useEffect, useRef, useState } from 'react'
+
+import { $activitySignal } from '../app/activityStore.js'
+import { $isStatusRuleOccluded, $overlayState, hasPromptOpen } from '../app/overlayStore.js'
+import { $turnState } from '../app/turnStore.js'
+import { $uiState } from '../app/uiStore.js'
+import { ActivityStatus } from '../lib/activityStatus.js'
+import type { Theme } from '../theme.js'
+
+interface ActivityTickerProps {
+  t: Theme
+  width: number
+  compacting: boolean
+}
+
+export function ActivityTicker({ t, width, compacting }: ActivityTickerProps) {
+  const signal = useStore($activitySignal)
+  const ui = useStore($uiState)
+  const turn = useStore($turnState)
+  const overlay = useStore($overlayState)
+  const occluded = useStore($isStatusRuleOccluded)
+  const tracker = useRef(new ActivityStatus())
+  const [now, setNow] = useState(Date.now)
+  const [tick, setTick] = useState(0)
+  const waiting = hasPromptOpen(overlay)
+  const view = tracker.current.update(
+    { sessionId: ui.sid ?? '', signal, tools: turn.tools, waiting, compacting },
+    Date.now()
+  )
+
+  useEffect(() => {
+    if (occluded) return
+    setNow(Date.now())
+    const timer = setInterval(
+      () => {
+        setNow(Date.now())
+        if (!waiting) setTick(value => value + 1)
+      },
+      waiting ? 1000 : 250
+    )
+    return () => clearInterval(timer)
+  }, [occluded, waiting])
+
+  return (
+    <Text color={t.color[ActivityStatus.colorKey(now - view.since)]} wrap="truncate-end">
+      {ActivityStatus.format(view, tick, now, width)}
+    </Text>
+  )
+}
