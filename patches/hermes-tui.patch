--- /dev/null
+++ b/ui-tui/src/__tests__/transcriptChronology.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest'
+
+import { toTranscriptMessages } from '../domain/messages.js'
+
+const transcriptText = (rows: unknown) => toTranscriptMessages(rows)
+  .flatMap(message => [...(message.tools ?? []), message.text]).join('\n')
+
+describe('restored transcript chronology', () => {
+  it.each([
+    { role: 'user', text: 'QUESTION_REPLY' },
+    { role: 'system', text: 'PROMPT_EXPIRED' },
+    { role: 'user', text: 'notification', display_kind: 'process_complete' },
+    { role: 'assistant', text: 'DISPLAY_EVENT', display_kind: 'custom_event' },
+    { role: 'user', text: 'model changed', display_kind: 'model_switch' }
+  ])('keeps preceding tools before a $role $display_kind boundary', boundary => {
+    const messages = toTranscriptMessages([
+      { role: 'tool', name: 'terminal', context: 'BEFORE_MARKER' }, boundary,
+      { role: 'tool', name: 'terminal', context: 'AFTER_MARKER' },
+      { role: 'assistant', text: 'FINAL_MARKER' }
+    ])
+
+    expect(messages[0]?.tools?.join('\n')).toContain('BEFORE_MARKER')
+    expect(messages[1]?.tools).toBeUndefined()
+    expect(messages.at(-1)?.tools?.join('\n')).toContain('AFTER_MARKER')
+  })
+
+  it('preserves the unfinished tool tail when resuming a running turn', () => {
+    const text = transcriptText([
+      { role: 'user', text: 'PROMPT_MARKER' },
+      { role: 'tool', name: 'terminal', context: 'BEFORE_MARKER' },
+      { role: 'tool', name: 'clarify', context: 'QUESTION_MARKER' },
+      { role: 'tool', name: 'terminal', context: 'AFTER_MARKER' }
+    ])
+
+    const markers = ['PROMPT_MARKER', 'BEFORE_MARKER', 'QUESTION_MARKER', 'AFTER_MARKER']
+    const positions = markers.map(marker => text.indexOf(marker))
+    expect(positions.every(position => position >= 0)).toBe(true)
+    expect(positions).toEqual([...positions].sort((first, second) => first - second))
+  })
+})
diff --git a/ui-tui/src/__tests__/turnStats.test.tsx b/ui-tui/src/__tests__/turnStats.test.tsx
new file mode 100644
index 0000000000..16c0294d53
--- /dev/null
+++ b/ui-tui/src/__tests__/turnStats.test.tsx
@@ -0,0 +1,156 @@
+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import chalk from 'chalk'
+import React from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { patchOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { formatTurnStats, TurnCost, TurnStats, turnStats } from '../app/turnStats.js'
+import { MessageLine } from '../components/messageLine.js'
+import { DEFAULT_THEME } from '../theme.js'
+
+vi.mock('../app/gatewayContext.js', () => ({ useGateway: () => ({ gw: null }) }))
+
+const usage = (output: number, avg_tps?: number) => ({ calls: 1, input: 0, output, total: output, avg_tps })
+
+describe('TurnStats', () => {
+  it('times a turn from submit to the final reply and averages its output tokens', () => {
+    const stats = new TurnStats()
+    stats.begin(1_000, usage(500))
+    const result = stats.finish(11_000, usage(900, 72))
+
+    expect(result).toEqual({ activeMs: 10_000, modelTps: 72, taskTps: 40, totalMs: 10_000, waitMs: 0 })
+  })
+
+  it('subtracts every span the user spent answering prompts', () => {
+    const stats = new TurnStats()
+    stats.begin(0, usage(0))
+    stats.observePrompt(true, 2_000)
+    stats.observePrompt(true, 3_000)
+    stats.observePrompt(false, 5_000)
+    stats.observePrompt(true, 8_000)
+    stats.observePrompt(false, 9_000)
+    const result = stats.finish(12_000, usage(180))
+
+    expect(result).toMatchObject({ activeMs: 8_000, totalMs: 12_000, waitMs: 4_000 })
+    expect(result?.taskTps).toBeCloseTo(22.5)
+  })
+
+  it('closes a prompt still open when the turn ends', () => {
+    const stats = new TurnStats()
+    stats.begin(0, usage(0))
+    stats.observePrompt(true, 1_000)
+
+    expect(stats.finish(4_000, usage(0))).toMatchObject({ activeMs: 1_000, taskTps: null, waitMs: 3_000 })
+  })
+
+  it('reports nothing without a started turn, and nothing twice', () => {
+    const stats = new TurnStats()
+    expect(stats.finish(1_000, usage(10))).toBeNull()
+    stats.begin(0, usage(0))
+    stats.observePrompt(true, 100)
+    stats.cancel()
+    expect(stats.finish(1_000, usage(10))).toBeNull()
+    stats.begin(0, usage(0))
+    stats.finish(1_000, usage(10))
+    expect(stats.finish(2_000, usage(20))).toBeNull()
+  })
+
+  it('ignores prompts that open outside a turn', () => {
+    const stats = new TurnStats()
+    stats.observePrompt(true, 0)
+    stats.begin(5_000, usage(0))
+    expect(stats.finish(6_000, usage(0))).toMatchObject({ waitMs: 0 })
+  })
+
+  it('counts an open clarify overlay as waiting', () => {
+    vi.useFakeTimers()
+
+    try {
+      vi.setSystemTime(0)
+      turnStats.begin(0, usage(0))
+      vi.setSystemTime(1_000)
+      patchOverlayState({ clarify: { answers: [], questions: [], requestId: 'r' } as never })
+      vi.setSystemTime(6_000)
+      resetOverlayState()
+
+      expect(turnStats.finish(7_000, usage(0))).toMatchObject({ waitMs: 5_000 })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
+
+describe('TurnCost', () => {
+  const receipts = (costs: Record<string, unknown>) => (_method: string, params: Record<string, unknown>) =>
+    Promise.resolve({ result: { estimated_cost_usd: costs[params.admission_id as string] } })
+
+  it('prices a turn as the growth of the cumulative cost since the previous completion', async () => {
+    const cost = new TurnCost()
+    const request = receipts({ a: 8.25, b: 8.75, c: 9.0 })
+    expect(await cost.settle(request, 's', 'a')).toBeNull()
+    expect(await cost.settle(request, 's', 'b')).toBeCloseTo(0.5)
+    expect(await cost.settle(request, 's', 'c')).toBeCloseTo(0.25)
+  })
+
+  it('keeps sessions apart and treats a reset counter as the whole turn', async () => {
+    const cost = new TurnCost()
+    const request = receipts({ a: 5, b: 1, x: 2, y: 2.5 })
+    await cost.settle(request, 's', 'a')
+    await cost.settle(request, 'other', 'x')
+    expect(await cost.settle(request, 's', 'b')).toBe(1)
+    expect(await cost.settle(request, 'other', 'y')).toBeCloseTo(0.5)
+  })
+
+  it('gives no cost when the receipt fails, lacks a cost or never answers', async () => {
+    const cost = new TurnCost(20)
+    expect(await cost.settle(() => Promise.reject(new Error('down')), 's', 'a')).toBeNull()
+    expect(await cost.settle(receipts({}), 's', 'a')).toBeNull()
+    expect(await cost.settle(() => new Promise(() => {}), 's', 'a')).toBeNull()
+    expect(await cost.settle(receipts({ a: 1 }), 's', undefined)).toBeNull()
+  })
+})
+
+describe('formatTurnStats', () => {
+  it('appends the estimated cost', () => {
+    expect(formatTurnStats({ activeMs: 9_000, costUsd: 0.0912, modelTps: null, taskTps: null, totalMs: 9_000, waitMs: 0 }))
+      .toBe('⏱ 9s · ≈$0.091')
+    expect(formatTurnStats({ activeMs: 9_000, costUsd: 1.234, modelTps: 72, taskTps: 38, totalMs: 9_000, waitMs: 0 }))
+      .toBe('⏱ 9s · 38 tok/s (model 72 tok/s) · ≈$1.23')
+  })
+
+  it('shows the time without waiting first and the full time in brackets', () => {
+    expect(formatTurnStats({ activeMs: 252_000, modelTps: 72.4, taskTps: 38.2, totalMs: 400_000, waitMs: 148_000 }))
+      .toBe('⏱ 4m 12s (6m 40s with waiting) · 38 tok/s (model 72 tok/s)')
+  })
+
+  it('drops the brackets when nobody waited and the speeds that are unknown', () => {
+    expect(formatTurnStats({ activeMs: 9_000, modelTps: null, taskTps: 4.25, totalMs: 9_000, waitMs: 0 }))
+      .toBe('⏱ 9s · 4.3 tok/s')
+    expect(formatTurnStats({ activeMs: 9_000, modelTps: null, taskTps: null, totalMs: 9_000, waitMs: 0 })).toBe('⏱ 9s')
+  })
+})
+
+describe('stats row', () => {
+  const level = chalk.level
+  beforeEach(() => { chalk.level = 3 })
+  afterEach(() => { chalk.level = level })
+
+  it('paints bright green text on black', () => {
+    const stdout = Object.assign(new PassThrough(), { columns: 60, isTTY: false, rows: 10 })
+    const stdin = Object.assign(new PassThrough(), { isTTY: true, isRaw: false, ref: vi.fn(), unref: vi.fn(), setRawMode: vi.fn() })
+    let output = ''
+    stdout.on('data', chunk => { output += chunk.toString() })
+    const view = renderSync(
+      <MessageLine cols={60} msg={{ kind: 'stats', role: 'system', text: '⏱ 9s · 4.3 tok/s' }} t={DEFAULT_THEME} />,
+      { patchConsole: false, stderr: new PassThrough() as never, stdin: stdin as never, stdout: stdout as never }
+    )
+    view.unmount()
+    view.cleanup()
+
+    expect(output).toContain('⏱ 9s · 4.3 tok/s')
+    expect(output).toMatch(/\x1b\[(?:[0-9;]*;)?38;2;0;255;0m/)
+    expect(output).toMatch(/\x1b\[(?:[0-9;]*;)?48;2;0;0;0m/)
+  })
+})
diff --git a/ui-tui/src/__tests__/userInputBackground.test.tsx b/ui-tui/src/__tests__/userInputBackground.test.tsx
