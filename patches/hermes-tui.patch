+import { useStore } from '@nanostores/react'
+import { useEffect, useReducer } from 'react'
+
+import { $overlayState, hasPromptOpen } from '../app/overlayStore.js'
+import { $uiState } from '../app/uiStore.js'
+import { EventTime } from '../lib/eventTime.js'
+import type { Theme } from '../theme.js'
+
+import { EventRow } from './eventRow.js'
+
+function TickingClock({ theme }: { theme: Theme }) {
+  const [, refresh] = useReducer((tick: number) => tick + 1, 0)
+
+  useEffect(() => {
+    const timer = setInterval(refresh, 1000)
+
+    return () => clearInterval(timer)
+  }, [])
+
+  return <EventRow createdAt={EventTime.now()} t={theme} timestampColor="#00ff00" />
+}
+
+export function WorkingClock() {
+  const ui = useStore($uiState)
+  const overlay = useStore($overlayState)
+
+  return ui.busy && !hasPromptOpen(overlay) ? <TickingClock key={ui.sid} theme={ui.theme} /> : null
+}
