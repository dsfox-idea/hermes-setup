@@ -0,0 +1,35 @@
+import type { Msg } from '../types.js'
+
+const INTERNAL_MARKER = '[INTERNAL NOTIFICATION \u2014 generated by the Hermes gateway, not written by a human user.'
+
+export const isServiceNotificationKind = (kind: unknown): boolean =>
+  kind === 'internal_notification' || kind === 'async_delegation_complete' || kind === 'process_complete'
+
+export const serviceNotificationTitle = (msg: Msg): null | string => {
+  if (msg.role !== 'user' && msg.role !== 'system') return null
+  const header = msg.text.split('\n', 1)[0] ?? ''
+  const process = /^\[(?:IMPORTANT: )?Background process (proc_[\w-]+)\b/.exec(header)
+  const delegation = /^\[ASYNC DELEGATION BATCH COMPLETE \u2014 (deleg_[\w-]+)\]/.exec(header)
+  if (msg.kind !== 'notification' && !((process || delegation) && msg.text.includes(INTERNAL_MARKER))) return null
+  const title = msg.notificationTitle?.split('\n', 1)[0]?.trim()
+  if (title && !process) return title
+  if (delegation) return `\u041f\u043e\u0434\u0430\u0433\u0435\u043d\u0442\u044b \u00b7 ${delegation[1]}`
+  if (!process)
+    return '\u0421\u043b\u0443\u0436\u0435\u0431\u043d\u043e\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435'
+
+  const exitCode = /exit code (-?\d+)/.exec(header)?.[1]
+  const state =
+    exitCode === '0'
+      ? '\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430'
+      : exitCode !== undefined
+        ? `\u043e\u0448\u0438\u0431\u043a\u0430, \u043a\u043e\u0434 ${exitCode}`
+        : /heartbeat|still running/.test(header)
+          ? '\u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f'
+          : '\u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435'
+  return `\u0424\u043e\u043d\u043e\u0432\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430: ${state} \u00b7 ${process[1]}`
+}
+
+export const asServiceNotification = (msg: Msg, internal = false, title?: string): Msg => {
+  const candidate: Msg = internal ? { ...msg, kind: 'notification', ...(title && { notificationTitle: title }) } : msg
+  return serviceNotificationTitle(candidate) === null ? msg : { ...candidate, kind: 'notification', role: 'system' }
+}
diff --git a/ui-tui/src/lib/activityStatus.ts b/ui-tui/src/lib/activityStatus.ts
new file mode 100644
index 0000000000..2b5f9bc75a
--- /dev/null
+++ b/ui-tui/src/lib/activityStatus.ts
@@ -0,0 +1,106 @@
+import { stringWidth } from '@hermes/ink'
+
+import type { ActivitySignal } from '../app/activityStore.js'
+import type { ActiveTool } from '../types.js'
+
+interface ActivityInput {
+  sessionId: string
+  signal: ActivitySignal
+  tools: ActiveTool[]
+  compacting: boolean
+  waiting: boolean
+}
+
+export interface ActivityView {
+  key: string
+  label: string
+  paused: boolean
+  since: number
+}
+
+const PHASE_LABELS = {
+  waiting: 'Ожидание модели',
+  reasoning: 'Получение рассуждений',
+  answer: 'Получение ответа',
+  preparing: 'Подготовка вызова'
+}
+
+const TOOL_LABELS: Record<string, string> = {
+  terminal: 'Выполнение команды',
+  execute_code: 'Выполнение кода',
+  read_file: 'Чтение файла',
+  search_files: 'Поиск в файлах',
+  write_file: 'Запись файла',
+  patch: 'Изменение файла',
+  web_search: 'Поиск в интернете',
+  web_extract: 'Чтение страницы',
+  browser_exec: 'Работа с браузером',
+  delegate_task: 'Работа подагента',
+  skill_view: 'Чтение навыка',
+  skill_manage: 'Изменение навыка',
+  memory: 'Обновление памяти',
+  clarify: 'Подготовка вопроса',
+  tool_call: 'Вызов инструмента',
+  process_manage: 'Ожидание процесса'
+}
+
+export class ActivityStatus {
+  private current: ActivityView | null = null
+
+  update(input: ActivityInput, now: number): ActivityView {
+    const signal = input.signal.sessionId === input.sessionId ? input.signal : { phase: 'waiting' as const, since: 0 }
+    let key: string = `${signal.phase}:${signal.since}`
+    let label = PHASE_LABELS[signal.phase]
+    if (input.waiting) {
+      key = 'input'
+      label = 'Требуется ответ'
+    } else if (input.compacting) {
+      key = 'compacting'
+      label = 'Сжатие контекста'
+    } else if (input.tools.length) {
+      const tool = input.tools[0]!
+      key = `tool:${tool.id}`
+      label = TOOL_LABELS[tool.name] ?? 'Выполнение инструмента'
+      if (input.tools.length > 1) label += ` +${input.tools.length - 1}`
+    }
+    key = `${input.sessionId}:${key}`
+    const since = this.current?.key === key ? this.current.since : now
+    this.current = { key, label, paused: input.waiting, since }
+    return this.current
+  }
+
+  static colorKey(elapsed: number): 'statusGood' | 'statusWarn' | 'statusCritical' {
+    if (elapsed >= 60 * 60_000) return 'statusCritical'
+    if (elapsed >= 10 * 60_000) return 'statusWarn'
+    return 'statusGood'
+  }
+
+  static frame(tick: number, paused: boolean): string {
+    if (paused) return '[────────]'
+    const offset = tick % 14
+    const position = offset <= 7 ? offset : 14 - offset
+    return `[${'░'.repeat(position)}█${'░'.repeat(7 - position)}]`
+  }
+
+  static format(view: ActivityView, tick: number, now: number, width: number): string {
+    const frame = this.frame(tick, view.paused)
+    const seconds = Math.max(0, Math.floor((now - view.since) / 1000))
+    const duration = seconds < 60 ? `${seconds}с` : `${Math.floor(seconds / 60)}м ${seconds % 60}с`
+    const tail = ` · ${duration}`
+    if (width < stringWidth(frame + tail) + 3) return this.clip(frame + tail, width)
+    const budget = width - stringWidth(frame + ' ' + tail)
+    const label = this.clip(view.label, budget)
+    return frame + ' ' + label + ' '.repeat(Math.max(0, budget - stringWidth(label))) + tail
+  }
+
+  private static clip(text: string, width: number): string {
+    if (width <= 0) return ''
+    if (stringWidth(text) <= width) return text
+    let result = ''
+    for (const character of text) {
+      if (stringWidth(result + character) > width - 1) break
+      result += character
+    }
+    return result + '…'
+  }
+}
